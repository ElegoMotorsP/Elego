<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ElegoMotors Custom Security Groups

        group_manufacturing_operator
            Only Pratik (Quality & Manufacturing) holds this group.
            It implies mrp.group_mrp_user so the holder gets the full MRP
            menu, but the "Produce All" / "Produce" buttons in the MO form
            are restricted to this group via view inheritance — meaning no
            other mrp.group_mrp_user (e.g. Prashant) can click Produce.

        group_store_billing
            Amit (Store Manager) holds this group.
            Purpose:
              • record rule (record_rules.xml)  — restricts account.move access
                to customer invoices only (move_type in out_invoice, out_refund)
              • view override (account_move_views.xml) — makes price_unit and
                discount fields read-only on the invoice form
            Amit keeps account.group_account_invoice so standard Odoo UI
            ("Create Invoice" button on SO/Delivery) continues to work.
            The record rule applies cleanly because account.group_account_invoice
            has no group-level record rules on account.move in Community edition —
            so Odoo's OR logic only evaluates the group_store_billing restriction.
    -->

    <!-- noupdate="0" — groups are refreshed on every upgrade -->
    <data noupdate="0">

        <!-- Manufacturing Operator — gates the Produce / Produce All buttons on MOs -->
        <record id="group_manufacturing_operator" model="res.groups">
            <field name="name">Manufacturing Operator</field>
            <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>
        </record>

        <!-- Store Billing — Amit's restricted accounting group -->
        <record id="group_store_billing" model="res.groups">
            <field name="name">Store: Customer Invoices (Read-only Prices)</field>
        </record>

        <!--
            group_purchase_viewer
                Amit (Store Manager) and Rajshri (Accounts) hold this group.
                Implies purchase.group_purchase_user so the holder sees the
                Purchase menu and can read POs, but the Python-level override in
                models/purchase_order.py raises AccessError on create(), so they
                cannot raise new Purchase Orders.
        -->
        <record id="group_purchase_viewer" model="res.groups">
            <field name="name">Purchase: View Only</field>
            <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        </record>

        <!--
            group_sale_viewer
                Amit (Store Manager) holds this group.
                Implies sales_team.group_sale_salesman so the holder sees the
                Sales menu and can read SOs/Quotations, but the Python-level
                override in models/sale_order.py raises AccessError on create(),
                so Amit cannot raise new Sales Orders.
        -->
        <record id="group_sale_viewer" model="res.groups">
            <field name="name">Sales: View Only</field>
            <!-- group_sale_manager allows reading ALL SOs regardless of salesperson.
                 group_sale_salesman was too restrictive — Odoo 18 record rules limit
                 it to the user's own SOs, blocking Amit from reading Priyanka's orders.
                 Python-level create() block in sale_order.py still prevents SO creation. -->
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        </record>

        <!--
            group_sale_approver  (13-Mar update)
                Rajshri (Accounts) holds this group.
                Rajshri must be able to APPROVE SOs (2-step approval requires
                sales_team.group_sale_manager) but must NOT create new SOs.
                This marker group is checked in models/sale_order.py create()
                to raise AccessError, preventing SO creation while the
                group_sale_manager right (SO approval) remains intact.
        -->
        <record id="group_sale_approver" model="res.groups">
            <field name="name">Sales: Approve Only (No Create)</field>
        </record>

        <!--
            group_inbound_operator  (13-Mar update)
                Controls who can see and use Gate Entry (Inward) and
                Issue to Production operation types.
                Members: Amit (Store), Manohar (Admin).
                Pratik (Quality) REMOVED from Gate Entry + Issue to Production.
                Set as group_id on picking_type_gate_entry and
                picking_type_production_issue in stock_picking_types_fix.xml.
        -->
        <record id="group_inbound_operator" model="res.groups">
            <field name="name">Inventory: Inbound / Issue Operator</field>
        </record>

        <!--
            group_qc_pass_operator  (13-Mar update)
                Controls who can see and use the QC Pass → Store operation type.
                Members: Pratik (Quality), Manohar (Admin).
                Amit (Store) REMOVED from QC Pass in 13-Mar update.
                Set as group_id on picking_type_qc_to_store in
                stock_picking_types_fix.xml.
        -->
        <record id="group_qc_pass_operator" model="res.groups">
            <field name="name">Inventory: QC Pass Operator</field>
        </record>

        <!--
            group_fg_transfer_operator  (13-Mar update)
                Controls who can see and use the FG to Finished Goods Store
                operation type (RM to FG in the updated matrix).
                Members: Pratik (Quality), Prashant (Purchase), Manohar (Admin).
                Amit (Store) REMOVED; Prashant (Purchase) ADDED in 13-Mar update.
                Set as group_id on picking_type_fg_to_stock in
                stock_picking_types_fix.xml.
        -->
        <record id="group_fg_transfer_operator" model="res.groups">
            <field name="name">Inventory: FG Transfer Operator</field>
        </record>

        <!--
            group_purchase_vendor_bill_viewer  (13-Mar update)
                Prashant (Purchase) gains read-only access to Vendor Bills.
                Implies account.group_account_invoice for model-level read access,
                but is restricted to in_invoice/in_refund records only via a
                record rule in record_rules.xml. Python create() override in
                account_move.py prevents new bill creation.
                Members: Prashant.
        -->
        <record id="group_purchase_vendor_bill_viewer" model="res.groups">
            <field name="name">Purchase: View Vendor Bills (Read-only)</field>
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        </record>

        <!-- QC Routing Wizard access: all internal users may open it;
             button_validate() already restricts who reaches the wizard. -->
        <record id="access_stock_picking_qc_wizard_all" model="ir.model.access">
            <field name="name">stock.picking.qc.wizard all</field>
            <field name="model_id" ref="model_stock_picking_qc_wizard"/>
            <field name="group_id" ref="base.group_user"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
