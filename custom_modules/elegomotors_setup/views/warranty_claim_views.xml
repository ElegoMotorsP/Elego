<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_warranty_claim_list" model="ir.ui.view">
            <field name="name">elegomotors.warranty.claim.list</field>
            <field name="model">elegomotors.warranty.claim</field>
            <field name="arch" type="xml">
                <list decoration-warning="state == 'submitted'"
                      decoration-success="state == 'completed'"
                      decoration-danger="state == 'rejected'"
                      decoration-muted="state == 'cancelled'">
                    <field name="claim_number"/>
                    <field name="create_date"/>
                    <field name="chassis_number"/>
                    <field name="model_name"/>
                    <field name="dealer_id"/>
                    <field name="faulty_part_name"/>
                    <field name="claim_type"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="view_warranty_claim_form" model="ir.ui.view">
            <field name="name">elegomotors.warranty.claim.form</field>
            <field name="model">elegomotors.warranty.claim</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_submit" type="object" string="Submit"
                                class="btn-primary" invisible="state != 'draft'"/>
                        <button name="action_approve" type="object" string="Approve"
                                class="btn-primary" invisible="state != 'submitted'"
                                groups="elegomotors_setup.group_warranty_manager,base.group_erp_manager"/>
                        <button name="action_reject" type="object" string="Reject"
                                invisible="state != 'submitted'"
                                groups="elegomotors_setup.group_warranty_manager,base.group_erp_manager"/>
                        <button name="action_complete" type="object" string="Complete"
                                class="btn-primary" invisible="state != 'approved'"
                                groups="elegomotors_setup.group_warranty_manager,base.group_erp_manager"/>
                        <button name="action_cancel" type="object" string="Cancel"
                                invisible="state in ('completed', 'cancelled')"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,submitted,approved,completed"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="claim_number" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="Unit &amp; Customer">
                                <field name="registration_id"/>
                                <field name="chassis_number" readonly="1"/>
                                <field name="model_name" readonly="1"/>
                                <field name="dealer_id" readonly="1"/>
                                <field name="customer_name" readonly="1"/>
                                <field name="customer_mobile" readonly="1"/>
                                <field name="customer_invoice_number" readonly="1"/>
                            </group>
                            <group string="Fault">
                                <field name="faulty_part_name"/>
                                <field name="faulty_part_serial"/>
                                <field name="reported_usage"/>
                                <field name="claim_type"/>
                                <field name="repair_location"/>
                            </group>
                        </group>
                        <group>
                            <field name="reason"/>
                            <field name="faulty_part_photo" widget="image" class="oe_avatar"/>
                        </group>
                        <group invisible="claim_type != 'replace'">
                            <field name="new_component_serial"/>
                            <field name="new_registration_id" readonly="1"/>
                        </group>
                        <group invisible="state != 'rejected'">
                            <field name="rejection_reason" readonly="1"/>
                        </group>
                        <group invisible="state != 'completed'">
                            <field name="zero_value_invoice_id" readonly="1"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_warranty_claim" model="ir.actions.act_window">
            <field name="name">Warranty Claims</field>
            <field name="res_model">elegomotors.warranty.claim</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Reject wizard -->
        <record id="view_warranty_claim_reject_wizard_form" model="ir.ui.view">
            <field name="name">elegomotors.warranty.claim.reject.wizard.form</field>
            <field name="model">elegomotors.warranty.claim.reject.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <field name="claim_id" invisible="1"/>
                    <group>
                        <field name="reason" placeholder="Reason for rejecting this claim"/>
                    </group>
                    <footer>
                        <button string="Reject Claim" type="object" name="action_confirm" class="btn-primary"/>
                        <button string="Cancel" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
