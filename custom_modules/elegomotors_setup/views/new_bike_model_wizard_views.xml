<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_new_bike_model_wizard_form" model="ir.ui.view">
            <field name="name">elegomotors.new.bike.model.wizard.form</field>
            <field name="model">elegomotors.new.bike.model.wizard</field>
            <field name="arch" type="xml">
                <form string="New Bike Model">
                    <div class="alert alert-info" role="alert">
                        Create a brand-new bike model, or add new colour
                        variant(s) — each with its own Bill of Materials — to
                        a model that already exists. Either way it's live
                        everywhere a bike model is expected (Bike
                        Traceability, Quality Control, Add Bike Combo, ...)
                        the moment you confirm below — no developer or module
                        upgrade needed.
                    </div>
                    <group>
                        <field name="mode" widget="radio"/>
                    </group>
                    <group string="1. New Model" invisible="mode != 'new_model'">
                        <field name="name" required="mode == 'new_model'"/>
                        <field name="x_serial_prefix" placeholder="EL40" required="mode == 'new_model'"/>
                        <field name="list_price"/>
                        <field name="standard_price"/>
                        <field name="x_material_code"/>
                    </group>
                    <group string="1. Existing Model" invisible="mode != 'add_variant'">
                        <field name="product_tmpl_id" required="mode == 'add_variant'"/>
                    </group>
                    <group string="2. Colour(s)">
                        <field name="colour_names" placeholder="Red, Black, White, Gray"/>
                    </group>
                    <group string="3. Bill of Materials">
                        <field name="bom_file" filename="bom_filename"/>
                        <field name="bom_filename" invisible="1"/>
                        <p class="text-muted" colspan="2">
                            CSV columns: <b>Component Name, Quantity, Colour</b>.
                            Leave Colour blank for a component common to every
                            colour above; name a specific colour (matching one
                            entered above, exactly) for a component only that
                            colour's BOM should include. Save an Excel sheet as
                            CSV first if needed.
                        </p>
                    </group>
                    <footer>
                        <button name="action_create" type="object"
                                string="Create Model" class="btn-primary"
                                invisible="mode != 'new_model'"/>
                        <button name="action_create" type="object"
                                string="Add Colour Variant(s)" class="btn-primary"
                                invisible="mode != 'add_variant'"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_new_bike_model_wizard" model="ir.actions.act_window">
            <field name="name">New Bike Model</field>
            <field name="res_model">elegomotors.new.bike.model.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- Parented directly under the app root, not menu_mrp_configuration:
             Configuration itself is gated to mrp.group_mrp_manager, which
             Manohar doesn't hold (he has mrp.group_mrp_user +
             mrp.group_mrp_routings) — under Configuration this item would be
             unreachable for him regardless of its own groups="" below. -->
        <menuitem id="menu_new_bike_model_wizard"
                  name="New Bike Model"
                  parent="mrp.menu_mrp_root"
                  action="action_new_bike_model_wizard"
                  groups="mrp.group_mrp_routings"
                  sequence="100"/>

    </data>
</odoo>
