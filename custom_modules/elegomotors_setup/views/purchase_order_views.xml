<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ElegoMotors Purchase Order Form — Receive Products Button Restrictions

        Issue 2: Hide the "Receive Products" smart button from Prashant (Purchase).
                 Only group_inbound_operator (Amit) and ERP Manager (Manohar)
                 should be able to see and navigate to Gate Entry receipts from a PO.

        Issue 3: The "Receive Products" button must also be invisible until Manohar
                 approves the PO (state must be 'purchase', not 'to approve').
                 In Odoo 18 2-step approval:
                   draft → sent → to approve → purchase (approved) → done
                 Receipt pickings are created at confirmation but should not be
                 accessible until full approval.

        Both restrictions are combined in a single xpath to avoid duplication.
    -->

    <record id="purchase_order_form_receive_restriction" model="ir.ui.view">
        <field name="name">purchase.order.form.receive.restriction</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <!-- Restrict the "Receive Products" stat button:
                 - groups: only Amit (group_inbound_operator) and Manohar (group_erp_manager)
                 - invisible: only show when PO is fully approved (state = purchase/done) -->
            <xpath expr="//button[@name='action_view_picking']" position="attributes">
                <attribute name="groups">elegomotors_setup.group_inbound_operator,base.group_erp_manager</attribute>
                <attribute name="invisible">state not in ('purchase', 'done')</attribute>
            </xpath>

        </field>
    </record>

    <!--
        Ordered / Received / To Receive on the PO lines. A short delivery no
        longer creates a backorder, so the PO itself shows what is still to
        come: Quantity (ordered), Received (on validated GRNs) and To Receive
        (the rest). Amit makes another GRN when the rest arrives.
    -->
    <record id="purchase_order_form_qty_to_receive" model="ir.ui.view">
        <field name="name">purchase.order.form.qty.to.receive</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='order_line']//field[@name='qty_received']" position="after">
                <field name="x_qty_remaining" string="To Receive"
                       column_invisible="parent.state not in ('purchase', 'done')"
                       optional="show"/>
            </xpath>

        </field>
    </record>

    <!--
        Vendor-Product restriction: once a vendor is picked on a PO, the order-line
        product picker only offers products that vendor is actually assigned to
        supply (product.supplierinfo — a product's Purchase tab > Vendor Pricelist).
        UI-level filter only, not a server-side constraint, so it does not affect
        purchase_bom_wizard.py's _add_or_merge_po_line, which creates PO lines
        directly for manufacturing BOM components, bypassing this picker entirely.

        A vendor with nothing yet in their Vendor Pricelist will show an empty
        product list here until products are assigned to them — expected, not a bug.
    -->
    <record id="purchase_order_form_product_vendor_restriction" model="ir.ui.view">
        <field name="name">purchase.order.form.product.vendor.restriction</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='order_line']//field[@name='product_id']" position="attributes">
                <attribute name="domain">[('seller_ids.partner_id', '=', parent.partner_id), ('purchase_ok', '=', True)]</attribute>
            </xpath>

        </field>
    </record>

    <!--
        Overseas vendor: the PO carries no tax at all. The taxes themselves are
        removed in Python (models/purchase_order_line.py); here the Taxes column
        on the lines is hidden so nobody is invited to pick one, and a note says
        why. With no taxes on any line Odoo's totals block shows no SGST / CGST /
        IGST rows, only Untaxed Amount and Total, so nothing more is needed there.
    -->
    <record id="purchase_order_form_overseas_no_tax" model="ir.ui.view">
        <field name="name">purchase.order.form.overseas.no.tax</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="x_overseas_supplier" invisible="1"/>
            </xpath>

            <xpath expr="//sheet" position="before">
                <div class="alert alert-info mb-0" role="alert" invisible="not x_overseas_supplier">
                    <strong>Overseas supplier.</strong> This order carries no GST or any other
                    tax. The import IGST is booked through the Bill of Entry.
                </div>
            </xpath>

            <xpath expr="//field[@name='order_line']/list//field[@name='taxes_id']" position="attributes">
                <attribute name="column_invisible">parent.x_overseas_supplier</attribute>
            </xpath>

        </field>
    </record>

</odoo>
