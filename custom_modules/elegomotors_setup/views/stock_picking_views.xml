<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ElegoMotors Receipt Form Enhancements

        1. Vendor Invoice Number + Date fields in the header
           (visible only on incoming receipts) — from d93d856

        2. QC tracking columns on the Operations tab move lines
           (Received, QC Passed, QC Failed, Final Quantities)
           Now readonly unless Gate Entry state is 'in_qc' — Issue 13

        3. Gate Entry QC workflow status bar + buttons — Issues 5/6
           Pending QC → In QC → Ready → Done (Odoo 'done' state)
           - "Start QC" (Pratik, group_qc_pass_operator)
           - "Approve QC" (Pratik, group_qc_pass_operator)
           Amit can only Validate when state is 'ready'

        4. Demand Qty column readonly for incoming receipts — Issue 13

        5. Pending Replacement warning banner — Issue 12
           Auto-set when QC failures exist; cleared by Amit manually
    -->

    <!-- ================================================================
         Outgoing Delivery — Serial No(s) column in picking list view
         Shows which bike serials are assigned/picked, visible during
         SO delivery validation so staff can trace the scooter picked.
         ================================================================ -->
    <record id="stock_picking_list_serial_nos" model="ir.ui.view">
        <field name="name">stock.picking.list.serial.nos</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="x_picked_serial_nos"
                       string="Serial No(s)"
                       optional="show"
                       column_invisible="picking_type_code != 'outgoing'"/>
            </field>
        </field>
    </record>

    <!-- ================================================================
         Outgoing Delivery form — Serial No(s) banner in the header area
         so the picked bike serial is immediately visible when validating.
         ================================================================ -->
    <record id="stock_picking_form_delivery_serial_banner" model="ir.ui.view">
        <field name="name">stock.picking.form.delivery.serial.banner</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info mb-0 py-2"
                     invisible="picking_type_code != 'outgoing' or not x_picked_serial_nos">
                    <strong>Bike Serial No(s) Picked:</strong>
                    <field name="x_picked_serial_nos" readonly="1" nolabel="1" class="ms-2 fw-bold"/>
                </div>
            </xpath>
            <!-- Hidden field needed for invisible condition above -->
            <xpath expr="//field[@name='origin']" position="after">
                <field name="x_picked_serial_nos" invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- ================================================================
         1. Vendor Invoice fields on receipt header (existing from d93d856)
         ================================================================ -->
    <record id="stock_picking_form_vendor_invoice" model="ir.ui.view">
        <field name="name">stock.picking.form.vendor.invoice.fields</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="x_vendor_invoice_number"
                       invisible="picking_type_code != 'incoming'"
                       placeholder="e.g. INV-2024/001"/>
                <field name="x_vendor_invoice_date"
                       invisible="picking_type_code != 'incoming'"/>
            </xpath>
        </field>
    </record>

    <!-- ================================================================
         2+3+4. Gate Entry QC flow: status bar, buttons, pending banner,
                QC columns (readonly gated on x_gate_entry_state), and
                demand qty readonly for all incoming receipts.
         ================================================================ -->
    <record id="stock_picking_form_gate_entry_qc_flow" model="ir.ui.view">
        <field name="name">stock.picking.form.gate.entry.qc.flow</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <!-- Hidden fields required for invisible/readonly conditions in the view -->
            <xpath expr="//field[@name='state']" position="after">
                <field name="x_gate_entry_state" invisible="1"/>
                <field name="x_has_pending_replacement" invisible="1"/>
                <field name="x_pending_replacement_qty" invisible="1"/>
                <field name="x_is_gate_entry" invisible="1"/>
            </xpath>

            <!-- Validate button visibility for incoming receipts is controlled in Python
                 via _compute_show_validate() override in stock_picking.py.
                 No view-level XPath needed — show_validate=False hides ALL Validate
                 buttons (stock, purchase_stock, etc.) for non-inbound-operators. -->

            <!-- Custom status bar: Pending QC → In QC → Ready (only on incoming, before done) -->
            <xpath expr="//field[@name='origin']" position="before">
                <field name="x_gate_entry_state"
                       widget="statusbar"
                       statusbar_visible="pending_qc,in_qc,ready"
                       invisible="picking_type_code != 'incoming' or state == 'done'"/>
            </xpath>

            <!-- Approve QC action button before the standard Validate button.
                 "Send to QC" removed — QC routing is now fully automatic on Validate. -->
            <xpath expr="//header/button[@name='button_validate']" position="before">
                <button name="action_gate_entry_approve_qc"
                        string="Approve QC"
                        type="object"
                        class="btn-success"
                        invisible="picking_type_code != 'incoming' or x_gate_entry_state != 'in_qc' or state == 'done'"
                        groups="elegomotors_setup.group_qc_pass_operator"/>
            </xpath>

            <!-- Pending Replacement warning banner (Issue 12) -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0"
                     invisible="not x_has_pending_replacement"
                     role="alert">
                    <strong>Pending Replacement:</strong>
                    <field name="x_pending_replacement_qty" readonly="1" nolabel="1"/>
                    item(s) awaiting replacement from vendor after QC failure.
                    <button name="action_clear_pending_replacement"
                            string="Mark Replacement Received"
                            type="object"
                            class="btn-sm btn-warning ms-2"
                            groups="elegomotors_setup.group_inbound_operator"/>
                </div>
            </xpath>

            <!-- Issue 13: make Demand Qty (quantity) readonly for incoming receipts -->
            <xpath expr="//field[@name='move_ids_without_package']//list//field[@name='quantity']" position="attributes">
                <attribute name="readonly">parent.picking_type_code == 'incoming'</attribute>
            </xpath>

            <!-- Show lot/serial column on incoming receipts only during QC phase —
                 Pratik assigns serials while inspecting; hidden before and after that window -->
            <xpath expr="//field[@name='move_ids_without_package']//list//field[@name='lot_ids']" position="attributes">
                <attribute name="column_invisible">parent.picking_type_code == 'incoming' and parent.x_gate_entry_state not in ('in_qc',)</attribute>
            </xpath>

        </field>
    </record>

    <!-- ================================================================
         QC Inspection tab — parameter checklist filled by Pratik
         Visible only when the picking has check result rows (i.e. after
         state → in_qc and product has parameters defined).
         Rows are editable only while state == 'in_qc'; read-only thereafter
         as a permanent audit trail.
         ================================================================ -->
    <record id="stock_picking_form_qc_inspection_tab" model="ir.ui.view">
        <field name="name">stock.picking.form.qc.inspection.tab</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='operations']" position="after">
                <page string="QC Inspection"
                      invisible="picking_type_code != 'incoming' or not x_qc_check_result_ids">
                    <field name="x_qc_check_result_ids" nolabel="1">
                        <list editable="bottom"
                              decoration-danger="result == 'fail'"
                              decoration-success="result == 'pass'">
                            <field name="product_id" column_invisible="1"/>
                            <field name="unit_index" string="Unit #" readonly="1"/>
                            <field name="lot_id"
                                   string="Serial / Lot No."
                                   context="{'default_product_id': product_id, 'default_company_id': parent.company_id}"
                                   options="{'no_open': True}"
                                   readonly="parent.state == 'done' or (parent.picking_type_code == 'incoming' and parent.x_gate_entry_state != 'in_qc')"/>
                            <field name="name" string="Parameter" readonly="1"/>
                            <field name="expected_value" string="Expected" readonly="1"/>
                            <field name="result_type" column_invisible="1"/>
                            <field name="check_description" string="How to Check" readonly="1" optional="hide"/>
                            <field name="actual_value"
                                   string="Actual Value / Observation"
                                   readonly="parent.state == 'done' or (parent.picking_type_code == 'incoming' and parent.x_gate_entry_state != 'in_qc')"/>
                            <field name="result"
                                   string="Pass / Fail"
                                   readonly="parent.state == 'done' or (parent.picking_type_code == 'incoming' and parent.x_gate_entry_state != 'in_qc')"/>
                            <field name="notes"
                                   string="Failure Reason"
                                   readonly="parent.state == 'done' or (parent.picking_type_code == 'incoming' and parent.x_gate_entry_state != 'in_qc')"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ================================================================
         QC columns on receipt Operations tab
         (replaces the original stock_picking_form_qc_columns record)
         Now includes readonly conditions tied to x_gate_entry_state — Issue 13
         ================================================================ -->
    <record id="stock_picking_form_qc_columns" model="ir.ui.view">
        <field name="name">stock.picking.form.qc.columns</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids_without_package']//list//field[@name='quantity']" position="after">
                <field name="x_qty_received"
                       string="Received"
                       column_invisible="parent.picking_type_code != 'incoming'"
                       readonly="parent.x_gate_entry_state not in ('pending_qc',) or parent.state == 'done'"/>
                <field name="x_qty_qc_passed"
                       string="QC Passed"
                       column_invisible="parent.picking_type_code != 'incoming'"
                       readonly="parent.x_gate_entry_state not in ('in_qc',) or parent.state == 'done'"/>
                <field name="x_qty_qc_failed"
                       string="QC Failed"
                       column_invisible="parent.picking_type_code != 'incoming'"/>
                <field name="x_qty_final"
                       string="Final Quantities"
                       column_invisible="parent.picking_type_code != 'incoming'"/>
            </xpath>
        </field>
    </record>

    <!-- ================================================================
         Consolidated Daily PI: show linked MOs + section header decoration
         ================================================================ -->
    <record id="stock_picking_form_consolidated_pi" model="ir.ui.view">
        <field name="name">stock.picking.form.consolidated.pi.fields</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <!-- Show linked MOs on the consolidated PI form header -->
            <xpath expr="//field[@name='origin']" position="after">
                <field name="x_consolidated_mo_ids"
                       widget="many2many_tags"
                       readonly="1"
                       string="Source MOs"
                       invisible="not x_consolidated_mo_ids"/>
            </xpath>

            <!-- Bold / highlighted decoration for section header rows in the move list -->
            <xpath expr="//field[@name='move_ids_without_package']//list" position="attributes">
                <attribute name="decoration-info">x_is_section_header</attribute>
                <attribute name="decoration-bf">x_is_section_header</attribute>
            </xpath>
            <xpath expr="//field[@name='move_ids_without_package']//list//field[@name='product_id']" position="before">
                <field name="x_is_section_header" column_invisible="1"/>
                <field name="x_section_label" column_invisible="1"/>
            </xpath>

        </field>
    </record>

</odoo>
