<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ElegoMotors — Quotation / Sales Order PDF column layout

        Matches the Tax Invoice column order:
        Sr.No. | Description of Goods | HSN Code | Qty | Rate | Disc.% | GST | Total Amount

        Base sale report order is already Description → Qty → Unit Price →
        Disc → Taxes → Amount, so this inherit adds the Sr.No. and HSN Code
        columns and relabels Unit Price → Rate, Taxes → GST,
        Amount → Total Amount.
    -->

    <template id="report_saleorder_document_ego" inherit_id="sale.report_saleorder_document">

        <!-- Header: Sr.No. before Description, HSN Code after it -->
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_ego_sr" class="text-center">Sr. No.</th>
        </xpath>
        <xpath expr="//th[@name='th_description']" position="after">
            <th name="th_ego_hsn" class="text-center">HSN Code</th>
        </xpath>

        <!-- Relabels -->
        <xpath expr="//th[@name='th_priceunit']" position="replace">
            <th name="th_priceunit" class="text-end">Rate</th>
        </xpath>
        <xpath expr="//th[@name='th_taxes']" position="replace">
            <th name="th_taxes" class="text-end">GST</th>
        </xpath>
        <xpath expr="//th[@name='th_subtotal']" position="replace">
            <th name="th_subtotal" class="text-end">
                <span groups="account.group_show_line_subtotals_tax_excluded">Total Amount</span>
                <span groups="account.group_show_line_subtotals_tax_included">Total Amount</span>
            </th>
        </xpath>

        <!-- Body cells (product lines only — sections/notes span the full
             row and are unaffected). Sr.No. counts product lines only.

             Bike combo numbering: a battery/charger line added at ₹0 by
             "Add Bike Combo" (x_is_combo_item=True) prints as a sub-item of
             the bike above it — "1", "1.1", "1.2", then "2", "2.1"…

             NOTE: this quotation PDF inherits Odoo's base
             sale.report_saleorder_document template, where td_name is NOT a
             direct child of its <tr> (confirmed by a build failure when an
             earlier version tried to target that row directly to hide
             combo-item rows and fold them into their parent's cell, the
             way report_invoice.xml — our own fully-owned template — does).
             Without visibility into that row's exact structure, only
             "before"/"after"/"inside" additions to existing named elements
             (td_name, th_*) are safe here; hiding/merging whole rows is
             not, so combo items keep their own numbered sub-row instead of
             being folded into the same box as on the Tax Invoice. -->
        <xpath expr="//td[@name='td_name']" position="before">
            <t t-set="ego_prior" t-value="lines_to_report[:line_index + 1]"/>
            <t t-set="ego_is_combo" t-value="not line.display_type and line.x_is_combo_item"/>
            <t t-set="ego_top_sr" t-value="len([l for l in ego_prior if not l.display_type and not l.x_is_combo_item])"/>
            <t t-if="ego_is_combo">
                <t t-set="ego_parent_positions" t-value="[i for i, l in enumerate(ego_prior) if not l.display_type and not l.x_is_combo_item]"/>
                <t t-set="ego_parent_idx" t-value="ego_parent_positions[-1] if ego_parent_positions else -1"/>
                <t t-set="ego_sub_sr" t-value="len([l for l in ego_prior[ego_parent_idx + 1:] if not l.display_type and l.x_is_combo_item])"/>
            </t>
            <td name="td_ego_sr" class="text-center">
                <span t-if="not ego_is_combo" t-esc="ego_top_sr"/>
                <span t-if="ego_is_combo" t-esc="'%s.%s' % (ego_top_sr, ego_sub_sr)"/>
            </td>
        </xpath>
        <xpath expr="//td[@name='td_name']" position="after">
            <td name="td_ego_hsn" class="text-center">
                <span t-esc="(line.product_id and line.product_id._fields.get('l10n_in_hsn_code') and line.product_id.l10n_in_hsn_code) or ''"/>
            </td>
        </xpath>

    </template>

</odoo>
