<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ElegoMotors — Quotation / Sales Order PDF column layout

        Matches the Tax Invoice column order:
        Sr.No. | Description of Goods | HSN Code | Qty | Rate | Disc.% | GST | Total Amount

        Base sale report order is already Description → Qty → Unit Price →
        Disc → Taxes → Amount, so this inherit adds the Sr.No. and HSN Code
        columns and relabels Unit Price → Rate, Taxes → GST,
        Amount → Total Amount.
    -->

    <template id="report_saleorder_document_ego" inherit_id="sale.report_saleorder_document">

        <!-- Header: Sr.No. before Description, HSN Code after it -->
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_ego_sr" class="text-center">Sr. No.</th>
        </xpath>
        <xpath expr="//th[@name='th_description']" position="after">
            <th name="th_ego_hsn" class="text-center">HSN Code</th>
        </xpath>

        <!-- Relabels -->
        <xpath expr="//th[@name='th_priceunit']" position="replace">
            <th name="th_priceunit" class="text-end">Rate</th>
        </xpath>
        <xpath expr="//th[@name='th_taxes']" position="replace">
            <th name="th_taxes" class="text-end">GST</th>
        </xpath>
        <xpath expr="//th[@name='th_subtotal']" position="replace">
            <th name="th_subtotal" class="text-end">
                <span groups="account.group_show_line_subtotals_tax_excluded">Total Amount</span>
                <span groups="account.group_show_line_subtotals_tax_included">Total Amount</span>
            </th>
        </xpath>

        <!-- Bike combo lines: a battery/charger added at ₹0 by "Add Bike
             Combo" (x_is_combo_item=True) gets NO row of its own — it's
             folded into its parent bike's row, listed inside the same
             Description cell ("same box"), matching the Tax Invoice
             treatment in report_invoice.xml.

             BEST-EFFORT NOTE: the row-hiding xpath below targets the <tr>
             that directly contains td_name, via a structural match rather
             than a named xpath — the base sale.report_saleorder_document
             template doesn't expose a name="..." on that row. If a future
             Odoo version restructures this template, this xpath may fail
             to apply (view inheritance error) or silently not match —
             verify visually after upgrading. -->
        <xpath expr="//tr[td[@name='td_name']]" position="attributes">
            <attribute name="t-if">not line.x_is_combo_item</attribute>
        </xpath>

        <!-- Sr.No. — plain top-level count; combo lines never reach this
             (their whole row is hidden above), so no sub-numbering needed. -->
        <xpath expr="//td[@name='td_name']" position="before">
            <td name="td_ego_sr" class="text-center">
                <span t-esc="len([l for l in lines_to_report[:line_index + 1] if not l.display_type and not l.x_is_combo_item])"/>
            </td>
        </xpath>
        <xpath expr="//td[@name='td_name']" position="after">
            <td name="td_ego_hsn" class="text-center">
                <span t-esc="(line.product_id and line.product_id._fields.get('l10n_in_hsn_code') and line.product_id.l10n_in_hsn_code) or ''"/>
            </td>
        </xpath>

        <!-- Combo children folded into the parent bike's Description cell. -->
        <xpath expr="//td[@name='td_name']" position="inside">
            <t t-set="ego_rest" t-value="lines_to_report[line_index + 1:]"/>
            <t t-set="ego_boundary_positions" t-value="[i for i, l in enumerate(ego_rest) if not l.x_is_combo_item or l.display_type]"/>
            <t t-set="ego_boundary" t-value="ego_boundary_positions[0] if ego_boundary_positions else len(ego_rest)"/>
            <t t-set="ego_combo_children" t-value="ego_rest[:ego_boundary]"/>
            <t t-foreach="ego_combo_children" t-as="child">
                <div style="padding-left:10px; font-size:0.85em; font-style:italic; color:#666;">
                    + <span t-esc="child.product_id.display_name"/> (Included)
                </div>
            </t>
        </xpath>

    </template>

</odoo>
