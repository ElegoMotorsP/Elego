<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Direct Reporting — lets a salesperson see, from their own login,
        which bikes they've sold to which dealer, filterable by dealer,
        bike model, "Handled By" (the shared-login person, see
        x_actual_salesperson on sale.order), and date/month.

        Data source is confirmed Sales Order lines only (state='sale'),
        bike products only (same x_is_ego_bike flag used everywhere else,
        e.g. mrp.production._get_ego_templates()) — not deliveries or
        invoices. No custom export code: the pivot view's native "download
        as Excel" and the list view's native Export button (already
        unlocked for this user via base.group_allow_export) cover it.

        Landing view has no default group_by — it's the combined "master
        report" across every salesperson sharing the login; the quick
        filters and group-by toggles below let one person isolate their
        own handled orders when they want to.
    -->

    <record id="view_direct_reporting_list" model="ir.ui.view">
        <field name="name">sale.order.line.direct.reporting.list</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <list string="Direct Reporting" create="0" edit="0" delete="0" default_order="x_report_date desc">
                <field name="order_id" string="Sales Order"/>
                <field name="x_report_date"/>
                <field name="x_report_partner_id"/>
                <field name="x_report_bike_tmpl_id"/>
                <field name="product_id"/>
                <field name="x_report_salesperson"/>
                <field name="product_uom_qty" string="Qty"/>
                <field name="price_subtotal" string="Amount" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_direct_reporting_pivot" model="ir.ui.view">
        <field name="name">sale.order.line.direct.reporting.pivot</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <pivot string="Direct Reporting">
                <field name="x_report_bike_tmpl_id" type="row"/>
                <field name="x_report_date" type="col" interval="month"/>
                <field name="product_uom_qty" type="measure"/>
                <field name="price_subtotal" type="measure" string="Amount"/>
            </pivot>
        </field>
    </record>

    <record id="view_direct_reporting_search" model="ir.ui.view">
        <field name="name">sale.order.line.direct.reporting.search</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <search string="Direct Reporting">
                <field name="x_report_partner_id" string="Dealer"/>
                <field name="x_report_bike_tmpl_id" string="Bike Model"/>
                <field name="order_id" string="Sales Order"/>
                <field name="x_report_salesperson" string="Handled By"/>
                <filter name="filter_order_date" string="Order Date" date="x_report_date"/>
                <separator/>
                <filter name="filter_handled_priyanka_kul" string="Handled By: Priyanka Kul"
                        domain="[('x_report_salesperson', '=', 'priyanka_kul')]"/>
                <filter name="filter_handled_priyanka_sutar" string="Handled By: Priyanka Sutar"
                        domain="[('x_report_salesperson', '=', 'priyanka_sutar')]"/>
                <filter name="filter_handled_srushti_gund" string="Handled By: Srushti Gund"
                        domain="[('x_report_salesperson', '=', 'srushti_gund')]"/>
                <group string="Group By">
                    <filter name="groupby_dealer" string="Dealer" context="{'group_by': 'x_report_partner_id'}"/>
                    <filter name="groupby_bike_model" string="Bike Model" context="{'group_by': 'x_report_bike_tmpl_id'}"/>
                    <filter name="groupby_handled_by" string="Handled By" context="{'group_by': 'x_report_salesperson'}"/>
                    <filter name="groupby_order_month" string="Order Month" context="{'group_by': 'x_report_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_direct_reporting" model="ir.actions.act_window">
        <field name="name">Direct Reporting</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="view_direct_reporting_search"/>
        <field name="domain">[('state', '=', 'sale'), ('product_id.product_tmpl_id.x_is_ego_bike', '=', True)]</field>
        <field name="help">
            Bike sales to dealers from confirmed Sales Orders. Filter by
            dealer, bike model, or "Handled By"; use the date filter's
            custom range or the Order Month group-by for a period view.
            Export via the pivot's Excel download or the list's Export
            button.
        </field>
    </record>

    <!-- Bind our own list/pivot views to the action explicitly — without
         this, Odoo would fall back to whatever default list/pivot view it
         finds for sale.order.line (there may be others from core/other
         reporting screens) instead of the ones defined above. -->
    <record id="action_direct_reporting_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_direct_reporting_list"/>
        <field name="act_window_id" ref="action_direct_reporting"/>
    </record>

    <record id="action_direct_reporting_view_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_direct_reporting_pivot"/>
        <field name="act_window_id" ref="action_direct_reporting"/>
    </record>

</odoo>
