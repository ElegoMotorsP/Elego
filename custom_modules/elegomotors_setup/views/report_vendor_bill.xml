<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ElegoMotors — Vendor Bill PDF: Sr. No. column

        account.report_invoice_document is Odoo's standard bill/invoice
        template — Customer Invoices route through this app's own fully-owned
        report_elegomotors_invoice_document instead (see report_invoice.xml),
        so in practice this inherit only affects Vendor Bills (and any
        Credit/Debit Notes that fall back to the standard template).

        Verified live on staging1 against every other module that also
        inherits this template (6 total): l10n_in (id 1704) inserts its HSN
        column via position="after" on the product <td>'s FIRST child, not
        "replace" — so, unlike the purchase-quotation report's l10n_in_purchase
        override, the anchor here (td[@name='account_invoice_line_name'])
        survives intact and is safe to target directly. l10n_in_edi (id 2280)
        doesn't touch the line table at all. Anchoring on that same td stays
        correctly aligned with l10n_in's own insertion since it inserts AFTER
        while this inserts BEFORE the same node — no column-count clash.
    -->

    <template id="report_invoice_document_ego" inherit_id="account.report_invoice_document">

        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_ego_sr" class="text-center">Sr. No.</th>
        </xpath>

        <xpath expr="//td[@name='account_invoice_line_name']" position="before">
            <t t-set="ego_prior" t-value="lines[:line_index + 1]"/>
            <td name="td_ego_sr" class="text-center">
                <span t-esc="len([l for l in ego_prior if l.display_type == 'product'])"/>
            </td>
        </xpath>

    </template>

</odoo>
