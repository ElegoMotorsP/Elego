<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ElegoMotors Account Move Form — Price Readonly for Store Billing Group

        When Amit (group_store_billing) opens a customer invoice, the unit
        price and discount fields are displayed as read-only. This ensures
        that prices from the Sales Order cannot be altered by the store
        manager when raising the invoice post-PDI.

        Implementation note:
        Static view-level approaches (groups_id on record, <data groups="...">
        wrapper, groups="..." on position element) all apply readonly=True to
        ALL users in Odoo 17, breaking Odoo's own account test suite.

        The correct approach is a computed Boolean field `store_billing_readonly`
        on account.move (see models/account_move.py) decorated with
        @api.depends_context('uid'). This evaluates to True only for
        group_store_billing users at runtime. The field is then referenced via
        parent.store_billing_readonly inside the invoice lines list, making
        price_unit and discount readonly only for Amit.
    -->

    <!-- ================================================================
         Invoice list view — add Sales Order ref, Delivery ref, Serial Nos
         so accountant can trace SO → Delivery → Bike serial during billing
         ================================================================ -->
    <record id="account_move_list_so_delivery_ref" model="ir.ui.view">
        <field name="name">account.move.list.so.delivery.ref</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <!-- Inject before Invoice Date — safe anchor that exists in all Odoo 18 invoice list builds -->
            <xpath expr="//field[@name='invoice_date']" position="before">
                <field name="x_so_ref"
                       string="Sales Order"
                       optional="show"/>
                <field name="x_delivery_ref"
                       string="Delivery Ref"
                       optional="show"/>
                <field name="x_serial_nos"
                       string="Serial No(s)"
                       optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- ================================================================
         Invoice form view — show SO ref, Delivery ref, Serial Nos in
         the "Other Info" tab so accountant sees traceability in one place
         ================================================================ -->
    <record id="account_move_form_so_delivery_ref" model="ir.ui.view">
        <field name="name">account.move.form.so.delivery.ref</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='invoice_tab']" position="before">
                <div class="alert alert-light border mb-0 py-2"
                     role="status"
                     invisible="move_type not in ('out_invoice', 'out_refund') or not x_so_ref">
                    <div class="row">
                        <div class="col-auto me-4">
                            <strong>Sales Order:</strong>
                            <field name="x_so_ref" readonly="1" nolabel="1" class="ms-1"/>
                        </div>
                        <div class="col-auto me-4">
                            <strong>Delivery:</strong>
                            <field name="x_delivery_ref" readonly="1" nolabel="1" class="ms-1"/>
                        </div>
                        <div class="col-auto">
                            <strong>Serial No(s):</strong>
                            <field name="x_serial_nos" readonly="1" nolabel="1" class="ms-1"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="account_move_form_transport_fields" model="ir.ui.view">
        <field name="name">account.move.form.transport.details</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Add a dedicated Transport Details tab after the Invoice Lines tab -->
            <xpath expr="//page[@name='invoice_tab']" position="after">
                <page string="Transport Details"
                      name="transport_tab"
                      invisible="move_type not in ('out_invoice', 'out_refund')">
                    <group>
                        <field name="x_transport_name" placeholder="e.g. Shivam Transport"/>
                        <field name="x_lr_number" placeholder="e.g. LR/2024/0001"/>
                        <field name="x_lr_date"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="account_move_form_store_billing_readonly" model="ir.ui.view">
        <field name="name">account.move.form.store.billing.prices.readonly</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Refresh Serial Numbers button — for already-posted invoices where
                 serials weren't injected at create/confirm time (e.g. invoice created
                 before delivery was validated). Only visible on customer invoices. -->
            <xpath expr="//header" position="inside">
                <button name="action_open_bike_scan_wizard"
                        string="Assign Bike Serials"
                        type="object"
                        invisible="move_type not in ('out_invoice', 'out_refund')"
                        class="btn-primary"/>
                <button name="action_refresh_ego_serials"
                        string="Refresh Serial Numbers"
                        type="object"
                        invisible="move_type not in ('out_invoice', 'out_refund')"
                        class="btn-secondary"/>
            </xpath>

            <!-- Inject the readonly indicator into the parent form.
                 The expression is non-constant so Odoo 17 does not flag it as
                 "always invisible"; the field is still hidden from the UI but
                 its value remains accessible via parent.store_billing_readonly
                 in the invoice_line_ids list. -->
            <field name="invoice_line_ids" position="before">
                <field name="store_billing_readonly"
                       invisible="store_billing_readonly or not store_billing_readonly"/>
            </field>

            <!-- Unit price — readonly when parent.store_billing_readonly is True -->
            <field name="price_unit" position="attributes">
                <attribute name="readonly">parent.store_billing_readonly</attribute>
            </field>

            <!-- Discount — readonly when parent.store_billing_readonly is True -->
            <field name="discount" position="attributes">
                <attribute name="readonly">parent.store_billing_readonly</attribute>
            </field>

        </field>
    </record>

</odoo>
