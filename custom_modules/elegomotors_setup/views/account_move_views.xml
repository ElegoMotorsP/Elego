<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ElegoMotors Account Move Form — Price Readonly for Store Billing Group

        When Amit (group_store_billing) opens a customer invoice, the unit
        price and discount fields are displayed as read-only. This ensures
        that prices from the Sales Order cannot be altered by the store
        manager when raising the invoice post-PDI.

        The view override uses groups="..." on each field attribute so that
        ONLY group_store_billing users see read-only prices (others see editable).

        The record_rules.xml rule ensures Amit can only see out_invoice /
        out_refund records — this view override additionally makes the
        pricing fields read-only on those records.
    -->

    <!--
        groups_id on the view record is the correct Odoo way to scope an entire
        view inheritance to a specific group. The scoping is done at the record
        level via groups_id, NOT via <data groups="..."> in the arch — the latter
        is evaluated at arch-combine time and would mark the field readonly for
        ALL users (including admin), breaking Odoo's own account test suite.
    -->
    <record id="account_move_form_store_billing_readonly" model="ir.ui.view">
        <field name="name">account.move.form.store.billing.prices.readonly</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="groups_id" eval="[(4, ref('elegomotors_setup.group_store_billing'))]"/>
        <field name="arch" type="xml">

            <!-- Unit price — read-only for store billing group -->
            <field name="price_unit" position="attributes">
                <attribute name="readonly">True</attribute>
            </field>

            <!-- Discount — read-only for store billing group -->
            <field name="discount" position="attributes">
                <attribute name="readonly">True</attribute>
            </field>

        </field>
    </record>

</odoo>
