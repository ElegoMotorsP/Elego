<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ElegoMotors Account Move Form — Price Readonly for Store Billing Group

        When Amit (group_store_billing) opens a customer invoice, the unit
        price and discount fields are displayed as read-only. This ensures
        that prices from the Sales Order cannot be altered by the store
        manager when raising the invoice post-PDI.

        Implementation note:
        Static view-level approaches (groups_id on record, <data groups="...">
        wrapper, groups="..." on position element) all apply readonly=True to
        ALL users in Odoo 17, breaking Odoo's own account test suite.

        The correct approach is a computed Boolean field `store_billing_readonly`
        on account.move (see models/account_move.py) decorated with
        @api.depends_context('uid'). This evaluates to True only for
        group_store_billing users at runtime. The field is then referenced via
        parent.store_billing_readonly inside the invoice lines list, making
        price_unit and discount readonly only for Amit.
    -->

    <record id="account_move_form_store_billing_readonly" model="ir.ui.view">
        <field name="name">account.move.form.store.billing.prices.readonly</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Refresh Serial Numbers button — for already-posted invoices where
                 serials weren't injected at create/confirm time (e.g. invoice created
                 before delivery was validated). Only visible on customer invoices. -->
            <xpath expr="//header" position="inside">
                <button name="action_refresh_ego_serials"
                        string="Refresh Serial Numbers"
                        type="object"
                        invisible="move_type not in ('out_invoice', 'out_refund')"
                        class="btn-secondary"/>
            </xpath>

            <!-- Inject the readonly indicator into the parent form.
                 The expression is non-constant so Odoo 17 does not flag it as
                 "always invisible"; the field is still hidden from the UI but
                 its value remains accessible via parent.store_billing_readonly
                 in the invoice_line_ids list. -->
            <field name="invoice_line_ids" position="before">
                <field name="store_billing_readonly"
                       invisible="store_billing_readonly or not store_billing_readonly"/>
            </field>

            <!-- Unit price — readonly when parent.store_billing_readonly is True -->
            <field name="price_unit" position="attributes">
                <attribute name="readonly">parent.store_billing_readonly</attribute>
            </field>

            <!-- Discount — readonly when parent.store_billing_readonly is True -->
            <field name="discount" position="attributes">
                <attribute name="readonly">parent.store_billing_readonly</attribute>
            </field>

        </field>
    </record>

</odoo>
