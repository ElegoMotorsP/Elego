<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Wizard form view ────────────────────────────────────────────── -->
    <record id="view_purchase_bom_wizard_form" model="ir.ui.view">
        <field name="name">elegomotors.purchase.bom.wizard.form</field>
        <field name="model">elegomotors.purchase.bom.wizard</field>
        <field name="arch" type="xml">
            <form string="Load BOM Components">
                <group col="4">
                    <field name="purchase_order_id" invisible="1"/>
                    <field name="model_selection" required="1"/>
                    <field name="purchase_mode" widget="radio" options="{'horizontal': true}" required="1"/>
                    <field name="kit_price" invisible="purchase_mode != 'kit'" required="purchase_mode == 'kit'"/>
                </group>

                <field name="color_line_ids" nolabel="1">
                    <list editable="bottom" create="false" delete="false" decoration-muted="not selected">
                        <field name="color" readonly="1" force_save="1"/>
                        <field name="selected"/>
                        <field name="bike_qty" string="No. of Bikes"/>
                    </list>
                </field>

                <!-- Shown in both modes — a Kit is just its components at a
                     lump-sum price, so this stays visible as a reference of
                     what's included even when Purchase Mode = Kit. Only
                     Components mode actually adds these as individual PO
                     lines; in Kit mode this is read-only for visibility only. -->
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" decoration-muted="not selected">
                        <field name="selected" readonly="parent.purchase_mode == 'kit'"/>
                        <field name="product_id" string="Component" readonly="1" force_save="1"/>
                        <field name="product_qty" string="Qty" readonly="parent.purchase_mode == 'kit'"/>
                        <field name="product_uom_id" string="UoM" readonly="1" force_save="1"/>
                    </list>
                </field>

                <footer>
                    <button name="action_load_components"
                            string="Add to Purchase Order"
                            type="object"
                            class="btn-primary"
                            invisible="(purchase_mode == 'components' and not line_ids) or (purchase_mode == 'kit' and not color_line_ids)"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ── Window action ──────────────────────────────────────────────── -->
    <record id="action_purchase_bom_wizard" model="ir.actions.act_window">
        <field name="name">Load BOM Components</field>
        <field name="res_model">elegomotors.purchase.bom.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ── Button on Purchase Order form ─────────────────────────────── -->
    <record id="purchase_order_form_bom_wizard_button" model="ir.ui.view">
        <field name="name">purchase.order.form.bom.wizard.button</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='button_confirm']" position="before">
                <button name="%(action_purchase_bom_wizard)d"
                        string="Load BOM Components"
                        type="action"
                        class="btn-secondary"
                        invisible="state not in ('draft', 'sent', 'to approve')"
                        context="{'default_purchase_order_id': id}"/>
            </xpath>
        </field>
    </record>

</odoo>
