<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ElegoMotors — Batch MO Creation Wizard

        Opens from: Manufacturing > Operations > Batch Production Order

        Flow:
          1. Click "Add a line" for each variant to produce.
          2. Select Product Model, Color, Battery Type, and Qty per row.
          3. Uncheck "Include" for any rows you want to skip.
          4. Click "Create & Issue Manufacturing Orders":
               - one MO per included row, all confirmed immediately
               - one consolidated Issue-to-Production picking for the entire batch
               - all MOs share a common Batch Reference
    -->

    <record id="view_batch_mo_wizard_form" model="ir.ui.view">
        <field name="name">elegomotors.batch.mo.wizard.form</field>
        <field name="model">elegomotors.batch.mo.wizard</field>
        <field name="arch" type="xml">
            <form string="Batch Production Order">
                <sheet>
                    <div class="alert alert-info mb-3" role="alert">
                        <strong>Batch MO Creation</strong> — Add one row per variant you want
                        to produce. Select the <strong>Model</strong>, <strong>Color</strong>
                        (determines the product variant), <strong>Battery Type</strong>
                        (production label), and quantity. You can mix multiple models and
                        colours in one batch. Click
                        <strong>Create &amp; Issue Manufacturing Orders</strong> to confirm all
                        MOs and generate a <strong>single consolidated Issue-to-Production
                        picking</strong> for the entire batch.
                    </div>

                    <field name="line_ids" widget="one2many_list">
                        <list editable="bottom" decoration-muted="not create_mo">
                            <field name="sequence" widget="handle"/>
                            <field name="create_mo" string="Include"
                                   widget="boolean_toggle"/>
                            <field name="product_tmpl_id"
                                   string="Model"
                                   placeholder="Select bike model…"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <!-- hidden but required for the colour domain below -->
                            <field name="valid_color_value_ids" column_invisible="1"/>
                            <field name="color_value_id"
                                   string="Color"
                                   placeholder="Red / Black / Gray / White…"
                                   domain="[('id', 'in', valid_color_value_ids)]"
                                   options="{'no_create': True}"/>
                            <field name="battery_type"
                                   string="Battery Type"
                                   placeholder="Lithium 60V30Ah…"/>
                            <field name="qty" string="Qty"/>
                            <field name="variant_display"
                                   string="Variant Summary"
                                   readonly="1"/>
                        </list>
                    </field>

                    <div class="text-muted small mt-2">
                        Rows greyed out with <em>Include</em> unchecked will be skipped.
                        All included rows share a single Batch Reference and a single
                        Issue-to-Production picking is generated immediately on confirm.
                    </div>
                </sheet>
                <footer>
                    <button name="action_confirm"
                            string="Create &amp; Issue Manufacturing Orders"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Server action that opens the wizard — attached to mrp.production -->
    <record id="action_batch_mo_wizard" model="ir.actions.act_window">
        <field name="name">Batch Production Order</field>
        <field name="res_model">elegomotors.batch.mo.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu entry: Manufacturing > Operations > Batch Production Order -->
    <menuitem
        id="menu_batch_mo_wizard"
        name="Batch Production Order"
        parent="mrp.menu_mrp_production_action"
        action="action_batch_mo_wizard"
        sequence="5"/>

</odoo>
