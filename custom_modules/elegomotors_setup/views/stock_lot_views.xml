<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ElegoMotors — Component Traceability Tab on Serial Number Records

        Adds a "Component Traceability" tab to the stock.lot form view.
        This tab is visible only when the lot/serial belongs to the EGO-S1
        finished product (or any of its colour variants).

        Pratik fills these fields after post-assembly barcode scanning:
          - Hub Motor Serial No.         (x_motor_serial)
          - Battery Pack Serial No.      (x_battery_serial)
          - Motor Controller Serial No.  (x_controller_serial)
          - Instrument Cluster Serial No.(x_cluster_serial)
          - Frame Assembly Serial No.    (x_frame_serial)

        A USB barcode scanner at the production workstation acts as keyboard
        input to these Char fields — no special app or module required.

        These five components have tracking='none' in Odoo stock so they move
        through Gate Entry → Store → Production WIP as plain quantities.
        The physical serial number is only known at assembly time, captured here.

        Use cases:
          - Warranty: customer gives bike serial → open record → see motor/battery serial
          - Parts: identify which exact motor is in a bike needing service
          - Reverse lookup: search x_motor_serial = 'MOT-001' to find the bike
    -->

    <record id="stock_lot_form_component_traceability" model="ir.ui.view">
        <field name="name">stock.lot.form.ego.component.traceability</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <!-- Blacklisted badge in the main header area -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="x_blacklisted" invisible="1"/>
                <div class="alert alert-danger mb-0 py-1 px-2"
                     invisible="not x_blacklisted"
                     role="alert"
                     style="display:inline-block">
                    <strong>BLACKLISTED — QC Fail.</strong>
                    This serial cannot be sold or transferred to store.
                </div>
            </xpath>

            <!-- Insert the Component Traceability tab after the standard tabs -->
            <xpath expr="//notebook" position="inside">
                <page string="Component Traceability"
                      invisible="[('product_id.product_tmpl_id.x_is_ego_bike', '=', False)]">
                    <group string="Manufacturing">
                        <field name="x_unbuild_id" invisible="1"/>
                        <field name="x_rebuild_mo_id" invisible="1"/>
                        <div>
                            <button type="object"
                                    name="action_view_manufacturing_orders"
                                    string="Open Manufacturing Order"
                                    class="btn-secondary btn-sm"/>
                            <button type="object"
                                    name="action_view_unbuild_order"
                                    string="Open Unbuild Order"
                                    class="btn-secondary btn-sm"
                                    invisible="not x_unbuild_id"/>
                            <button type="object"
                                    name="action_view_rebuild_mo"
                                    string="Open Rebuild MO"
                                    class="btn-secondary btn-sm"
                                    invisible="not x_rebuild_mo_id"/>
                            <button type="object"
                                    name="action_unbuild_bike"
                                    string="Unbuild This Bike"
                                    class="btn-primary btn-sm"
                                    invisible="x_unbuild_id"
                                    confirm="This will unbuild this bike serial, recover its components to Production WIP, and automatically create a rebuild MO. Continue?"
                                    groups="elegomotors_setup.group_unbuild_rebuild_operator"/>
                        </div>
                    </group>
                    <group string="Warranty-Critical Component Serials">
                        <group>
                            <field name="x_chassis_serial"
                                   placeholder="Chassis / frame plate serial no."/>
                            <field name="x_motor_serial"
                                   placeholder="Scan or enter Hub Motor serial no."/>
                            <field name="x_controller_serial"
                                   placeholder="Scan or enter Motor Controller serial no."/>
                            <field name="x_battery_serial"
                                   placeholder="Scan or enter Battery Pack serial no."/>
                            <field name="x_charger_serial"
                                   placeholder="Scan or enter Charger serial no."/>
                        </group>
                        <group>
                            <field name="x_color"
                                   placeholder="Colour"/>
                            <field name="x_battery_type"
                                   placeholder="Battery Type"/>
                            <field name="x_cluster_serial"
                                   placeholder="Scan or enter Instrument Cluster serial no."/>
                            <field name="x_frame_serial"
                                   placeholder="Scan or enter Frame Assembly serial no."/>
                        </group>
                    </group>
                    <p class="text-muted">
                        Scan each component barcode after assembly to record
                        the unit-level traceability for this vehicle.
                    </p>
                </page>

                <!-- PDI (Pre-Delivery Inspection) tab — any ElegoMotors bike model -->
                <page string="PDI Inspection"
                      invisible="[('product_id.product_tmpl_id.x_is_ego_bike', '=', False)]">
                    <group>
                        <field name="x_pdi_state" widget="badge"
                               decoration-success="x_pdi_state == 'passed'"
                               decoration-warning="x_pdi_state == 'pending'"
                               decoration-danger="x_pdi_state == 'failed'"/>
                        <field name="x_pdi_checked_date" readonly="1"/>
                    </group>
                    <div class="mb-2">
                        <button type="object" name="action_pdi_approve"
                                string="Approve PDI" class="btn-primary"
                                invisible="x_pdi_state == 'passed'"/>
                        <button type="object" name="action_pdi_fail"
                                string="Fail PDI" class="btn-secondary"
                                invisible="x_pdi_state == 'failed'"/>
                        <button type="object" name="action_pdi_reset"
                                string="Reset PDI" class="btn-secondary"
                                invisible="x_pdi_state == 'pending'"/>
                    </div>
                    <field name="x_pdi_check_result_ids">
                        <list editable="bottom">
                            <field name="category"/>
                            <field name="name"/>
                            <field name="result"/>
                            <field name="notes"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>


</odoo>
