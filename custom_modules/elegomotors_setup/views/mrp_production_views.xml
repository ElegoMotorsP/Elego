<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ElegoMotors MRP Production Form — Produce Button Restriction

        Restricts the "Produce All" and "Produce" buttons on the Manufacturing
        Order form so that ONLY users in group_manufacturing_operator (Pratik)
        can initiate production.

        All other mrp.group_mrp_user members (Prashant, Manohar) retain full
        MO view/edit access but cannot click Produce — enforcing the workflow:
          Store (Amit) issues material → Pratik validates receipt →
          Pratik clicks Produce All → MO done.

        IMPORTANT — Button name verification:
          The exact button name(s) depend on the installed Odoo 18 version.
          To verify: open any MO in Developer Mode, right-click the "Produce All"
          button → Inspect. Find the element with data-name or name attribute.
          Common names across Odoo 16–18:
            button_produce_all   ← Produce All (qty done = planned qty)
            button_produce       ← Produce (opens produce wizard)
          Update the name attributes below if different in your build.
    -->

    <record id="mrp_production_form_ego_produce_restrict" model="ir.ui.view">
        <field name="name">mrp.production.form.ego.produce.restrict</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <!-- "Produce All" — sets qty_producing = product_qty and marks done -->
            <button name="button_produce_all" position="attributes">
                <attribute name="groups">elegomotors_setup.group_manufacturing_operator</attribute>
            </button>

            <!-- "Produce" — opens immediate production / record components wizard -->
            <button name="button_produce" position="attributes">
                <attribute name="groups">elegomotors_setup.group_manufacturing_operator</attribute>
            </button>

            <!-- "Record Production" variant used in some Odoo 18 builds -->
            <button name="action_produce" position="attributes">
                <attribute name="groups">elegomotors_setup.group_manufacturing_operator</attribute>
            </button>

        </field>
    </record>

</odoo>
