<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ElegoMotors Manufacturing Order — Post-Production QC Buttons

        Adds "Pass QC" / "Fail QC" / "Reset QC" buttons and a QC status badge
        to the MO form header. Only visible when the MO is in 'to_close' state
        (production quantities entered, awaiting QC approval before mark-done).

        Button visibility:
          Pass QC  — to_close state + not already passed, quality_manager group only
          Fail QC  — to_close state, quality_manager group only
          Reset QC — to_close state + currently failed (for rework cycle)

        The "Mark as Done" button is NOT hidden — attempting to click it without
        QC approval raises a clear UserError from mrp_production.py Guard 3.

        Quality group: quality.group_quality_manager = Pratik
        (quality.quality_manager group includes Pratik via users_data.xml)
    -->
    <record id="mrp_production_form_view_qc" model="ir.ui.view">
        <field name="name">mrp.production.form.qc.buttons</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//header/field[@name='state']" position="after">
                <field name="mo_flow_state" widget="statusbar"
                       statusbar_visible="manufactured,in_qc,done"
                       invisible="state not in ('progress', 'to_close', 'done')"/>
                <field name="qc_state" invisible="1"/>
                <field name="ego_unit_qc_count" invisible="1"/>
            </xpath>

            <xpath expr="//header/button[@name='button_mark_done']" position="before">
                <button name="action_qc_pass"
                        string="Pass QC"
                        type="object"
                        class="btn-success"
                        invisible="state != 'to_close' or qc_state == 'passed'"
                        groups="quality.group_quality_manager"/>
                <button name="action_qc_fail"
                        string="Fail QC"
                        type="object"
                        class="btn-danger"
                        invisible="state != 'to_close'"
                        groups="quality.group_quality_manager"/>
                <button name="action_qc_reset"
                        string="Reset QC"
                        type="object"
                        invisible="state != 'to_close' or qc_state != 'failed'"
                        groups="quality.group_quality_manager"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_ego_view_unit_quality_checks" type="object"
                        class="oe_stat_button" icon="fa-check-square-o"
                        invisible="ego_unit_qc_count == 0" groups="quality.group_quality_manager">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="ego_unit_qc_count"/></span>
                        <span class="o_stat_text">Unit QC</span>
                    </div>
                </button>
            </xpath>

        </field>
    </record>

    <record id="mrp_production_form_manufacture_labels" model="ir.ui.view">
        <field name="name">mrp.production.form.manufacture.labels</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <!-- Odoo forbids using @confirm in xpath selectors; select via invisible expressions instead. -->
            <xpath expr="//header/button[@name='button_mark_done' and contains(@invisible,'not move_raw_ids or not show_produce')][1]" position="attributes">
                <attribute name="string">Manufacture</attribute>
            </xpath>
            <xpath expr="//header/button[@name='button_mark_done' and contains(@invisible,'not move_raw_ids or not show_produce_all')][1]" position="attributes">
                <attribute name="string">Manufacture All</attribute>
            </xpath>
            <xpath expr="//header/button[@name='button_mark_done' and contains(@invisible,'move_raw_ids or not show_produce')][1]" position="attributes">
                <attribute name="string">Manufacture</attribute>
            </xpath>
            <xpath expr="//header/button[@name='button_mark_done' and contains(@invisible,'move_raw_ids or not show_produce_all')][1]" position="attributes">
                <attribute name="string">Manufacture All</attribute>
            </xpath>
        </field>
    </record>
</odoo>
