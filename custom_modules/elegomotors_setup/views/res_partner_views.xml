<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            Adds the Finance API dealer code to the Contact form's
            Sales & Purchase tab. Values come from the finance partner
            (e.g. Bajaj Finance) — this field just stores what they assign,
            it does not generate a code.
        -->
        <record id="res_partner_form_finance_api" model="ir.ui.view">
            <field name="name">res.partner.form.finance.api</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <page name="sales_purchase" position="inside">
                    <group string="Finance API">
                        <field name="x_dealer_code"/>
                    </group>
                </page>
            </field>
        </record>
    </data>
</odoo>
