<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ElegoMotors Sales Order — Approval Workflow

        Quotation → Quotation Sent → Quotation Accepted → Sales Order

        1. Salesperson sends the quotation to the customer (state 'sent').
           Only "Send by Email" shows on a draft quotation.
        2. When the customer accepts, salesperson clicks "Quotation Accepted"
           (custom state 'accepted') — this automatically sends the order
           for SO confirmation (pending_approval = True).
        3. The Approve click by Rajshri/Manohar IS the SO confirmation:
           the order becomes a Sales Order only then. Base Confirm buttons
           are hidden; direct confirmations (portal signature, API) instead
           arm the approval gate on the confirmed SO, where delivery
           validation and invoicing stay blocked until approved:

          • Approve (Accounts) — visible only to group_sale_approver (Rajshri)
          • Approve (MD)       — visible only to base.group_erp_manager (Manohar)
          • Reject Order       — either approver; cancels deliveries and
                                 returns the order to Draft (mandatory reason)
    -->

    <!-- Note: "Create Invoice" restriction is enforced in sale_order.py
         via action_create_invoice() override — raises AccessError for
         non-accounting users. View-level approach was dropped because the
         button name differs between Odoo 18 Community and Enterprise. -->

    <record id="sale_order_form_dual_approval" model="ir.ui.view">
        <field name="name">sale.order.form.dual.approval</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Inject the three hidden approval fields so the view can
                 reference them in invisible/readonly expressions. -->
            <field name="state" position="after">
                <field name="pending_approval" invisible="1"/>
                <field name="approval_accounts" invisible="1"/>
                <field name="approval_manohar" invisible="1"/>
                <field name="rejection_reason" invisible="1"/>
                <field name="sale_order_number" invisible="not sale_order_number" readonly="1"/>
            </field>

            <!-- Show the custom 'Quotation Accepted' stage in the status bar -->
            <field name="state" position="attributes">
                <attribute name="statusbar_visible">draft,sent,accepted,sale</attribute>
            </field>

            <!-- Hide both base Confirm buttons (sent-primary + draft-secondary):
                 salespeople never confirm manually — the Approve click by
                 Rajshri/Manohar performs the SO confirmation. -->
            <xpath expr="(//header/button[@name='action_confirm'])[1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="(//header/button[@name='action_confirm'])[2]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Approval action buttons in the form header -->
            <xpath expr="//header/button[@name='action_confirm']" position="after">

                <!-- Salesperson records the customer's acceptance — only once
                     the quotation has been sent. This sends the order for
                     approval/SO confirmation automatically. -->
                <button name="action_mark_accepted"
                        string="Quotation Accepted"
                        type="object"
                        class="btn-primary"
                        groups="sales_team.group_sale_salesman"
                        invisible="state != 'sent'"/>

                <!-- Accounts approval — only Rajshri (group_sale_approver) -->
                <button name="action_approve_accounts"
                        string="Approve (Accounts)"
                        type="object"
                        class="btn-success"
                        groups="elegomotors_setup.group_sale_approver"
                        invisible="not pending_approval or approval_accounts"/>

                <!-- MD approval — only Manohar (group_erp_manager) -->
                <button name="action_approve_manohar"
                        string="Approve (MD)"
                        type="object"
                        class="btn-success"
                        groups="base.group_erp_manager"
                        invisible="not pending_approval or approval_manohar"/>

                <!-- Reject — visible to either approver while pending; opens a
                     wizard that requires a rejection reason. -->
                <button name="%(action_sale_order_reject_wizard)d"
                        string="Reject Order"
                        type="action"
                        class="btn-danger"
                        context="{'default_order_id': id}"
                        groups="elegomotors_setup.group_sale_approver,base.group_erp_manager"
                        invisible="not pending_approval"/>

                <!-- Request Changes — creator/approver/admin can reopen a
                     confirmed order for editing; re-arms the approval gate.
                     Python enforces who may actually click it. -->
                <button name="action_request_changes"
                        string="Request Changes"
                        type="object"
                        class="btn-secondary"
                        confirm="Reset this order to Draft so it can be edited? It will need approval again before it's re-confirmed."
                        groups="sales_team.group_sale_salesman,elegomotors_setup.group_sale_approver,base.group_erp_manager"
                        invisible="state != 'sale' or pending_approval"/>

            </xpath>

            <!-- Approval status panel — shown only while pending -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0"
                     invisible="not pending_approval"
                     role="alert">
                    <strong>Awaiting Approval</strong> — this order needs approval from either Accounts (Rajshri) or MD (Manohar).
                    Their approval confirms it as a Sales Order; until then it cannot proceed to delivery or invoicing.
                    <ul class="mb-0 mt-1">
                        <li>
                            Accounts (Rajshri):
                            <span invisible="not approval_accounts" class="text-success"><strong>&#10003; Approved</strong></span>
                            <span invisible="approval_accounts" class="text-muted">Pending…</span>
                        </li>
                        <li>
                            MD (Manohar):
                            <span invisible="not approval_manohar" class="text-success"><strong>&#10003; Approved</strong></span>
                            <span invisible="approval_manohar" class="text-muted">Pending…</span>
                        </li>
                    </ul>
                </div>
                <div class="alert alert-danger mb-0"
                     invisible="not rejection_reason"
                     role="alert">
                    <strong>Rejected</strong> — this Sales Order was rejected and returned to Draft.
                    <div><strong>Reason:</strong> <field name="rejection_reason" readonly="1" nolabel="1" class="d-inline"/></div>
                </div>
            </xpath>

            <!-- Lock line details (qty, price, product, etc.) once the order
                 is confirmed. Editing resumes only via "Request Changes",
                 which resets the order to Draft. -->
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="readonly">state == 'sale'</attribute>
            </xpath>

        </field>
    </record>

</odoo>
