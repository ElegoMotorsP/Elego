<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Sales Return — return specific bikes (by serial) from an already-
        posted customer invoice, optionally including battery/charger/other
        accessory quantities from the same invoice. Creates a draft credit
        note (Amit creates, Rajshri posts — same split as every other
        invoice) and moves the returned bikes straight back to
        EGO/Finished Goods via the dedicated "Sales Return" operation type.

        Access: elegomotors_setup.group_store_billing (Amit) or
        base.group_erp_manager (Manohar) — enforced in Python
        (sales_return_wizard.py) as well as hidden here.
    -->

    <record id="view_sales_return_wizard_form" model="ir.ui.view">
        <field name="name">elegomotors.sales.return.wizard.form</field>
        <field name="model">elegomotors.sales.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Sales Return">
                <sheet>
                    <div class="alert alert-warning mb-3" role="alert">
                        <strong>Select the bike(s) being returned</strong>, and any
                        battery/charger/accessory quantities from the same invoice
                        that are also coming back. A reason is required. Confirming
                        creates a draft credit note against the original invoice and
                        moves the returned bike(s) straight into Finished Goods stock.
                    </div>
                    <field name="invoice_id" invisible="1"/>

                    <group string="Bikes">
                        <field name="bike_line_ids" nolabel="1">
                            <list editable="bottom" create="false" delete="false">
                                <field name="selected"/>
                                <field name="product_display" string="Bike" readonly="1"/>
                                <field name="amount" string="Return Value" readonly="1"/>
                                <field name="lot_id" column_invisible="1"/>
                                <field name="invoice_line_id" column_invisible="1"/>
                                <field name="currency_id" column_invisible="1"/>
                            </list>
                        </field>
                    </group>

                    <group string="Accessories (optional)" invisible="not accessory_line_ids">
                        <field name="accessory_line_ids" nolabel="1">
                            <list editable="bottom" create="false" delete="false">
                                <field name="product_display" string="Item" readonly="1"/>
                                <field name="max_qty" string="Invoiced Qty" readonly="1"/>
                                <field name="qty_returned" string="Qty to Return"/>
                                <field name="invoice_line_id" column_invisible="1"/>
                            </list>
                        </field>
                    </group>

                    <group>
                        <field name="amount_total" readonly="1" string="Total Return Amount"/>
                        <field name="reason" placeholder="Why is this being returned? (required)"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm"
                            string="Create Sales Return"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- "Create Sales Return" button on posted customer invoices -->
    <record id="account_move_form_sales_return_button" model="ir.ui.view">
        <field name="name">account.move.form.sales.return.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="x_assigned_lot_ids" invisible="1"/>
                <button name="action_open_sales_return_wizard"
                        string="Create Sales Return"
                        type="object"
                        class="btn-secondary"
                        invisible="move_type != 'out_invoice' or state != 'posted' or not x_assigned_lot_ids"
                        groups="elegomotors_setup.group_store_billing,base.group_erp_manager"/>
            </xpath>
        </field>
    </record>

    <!-- Sales Return history tab -->
    <record id="account_move_form_sales_return_history" model="ir.ui.view">
        <field name="name">account.move.form.sales.return.history</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Sales Returns" invisible="not x_sales_return_ids">
                    <field name="x_sales_return_ids" nolabel="1" readonly="1">
                        <list>
                            <field name="create_date" string="When"/>
                            <field name="create_uid" string="By"/>
                            <field name="lot_ids" widget="many2many_tags"/>
                            <field name="credit_note_id"/>
                            <field name="picking_id"/>
                            <field name="amount_total"/>
                            <field name="reason"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
