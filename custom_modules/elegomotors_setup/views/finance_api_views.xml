<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Finance API Client -->
        <record id="view_finance_api_client_list" model="ir.ui.view">
            <field name="name">elegomotors.finance.api.client.list</field>
            <field name="model">elegomotors.finance.api.client</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="client_id"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_finance_api_client_form" model="ir.ui.view">
            <field name="name">elegomotors.finance.api.client.form</field>
            <field name="model">elegomotors.finance.api.client</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_generate_credentials" type="object"
                                string="Generate Credentials" class="btn-primary"
                                confirm="This replaces any existing credentials for this client — the old client_secret stops working immediately. Continue?"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="client_id" readonly="1"/>
                        </group>
                        <group string="Dealer Access">
                            <field name="allowed_dealer_ids" widget="many2many_tags"
                                   nolabel="1" colspan="2"
                                   placeholder="Leave empty to allow every dealer (default) — add dealers here to restrict this client to only their data."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_finance_api_client" model="ir.actions.act_window">
            <field name="name">Finance API Clients</field>
            <field name="res_model">elegomotors.finance.api.client</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- One-time secret display wizard -->
        <record id="view_finance_api_client_secret_wizard_form" model="ir.ui.view">
            <field name="name">elegomotors.finance.api.client.secret.wizard.form</field>
            <field name="model">elegomotors.finance.api.client.secret.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <div class="alert alert-warning" role="alert">
                        Copy the client secret now — it is not stored anywhere and
                        cannot be shown again. If it's lost, generate new credentials.
                    </div>
                    <group>
                        <field name="client_id" readonly="1"/>
                        <field name="client_secret" readonly="1"/>
                    </group>
                    <footer>
                        <button string="Close" class="btn-primary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Finance API Request Log -->
        <record id="view_finance_api_log_list" model="ir.ui.view">
            <field name="name">elegomotors.finance.api.log.list</field>
            <field name="model">elegomotors.finance.api.log</field>
            <field name="arch" type="xml">
                <list create="false" edit="false" delete="false">
                    <field name="create_date" string="When"/>
                    <field name="client_id"/>
                    <field name="material_code"/>
                    <field name="serial_number"/>
                    <field name="dealer_code"/>
                    <field name="response_status"/>
                    <field name="response_message"/>
                </list>
            </field>
        </record>

        <record id="action_finance_api_log" model="ir.actions.act_window">
            <field name="name">Finance API Request Log</field>
            <field name="res_model">elegomotors.finance.api.log</field>
            <field name="view_mode">list</field>
        </record>

        <!-- Dealers quick-edit: assign x_dealer_code without leaving the
             Finance API app or hunting through Contacts one at a time. -->
        <record id="view_finance_api_dealers_list" model="ir.ui.view">
            <field name="name">res.partner.finance.api.dealers.list</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <list editable="bottom" create="0" delete="0">
                    <field name="name"/>
                    <field name="x_dealer_code" string="Dealer Code (Finance API)"/>
                </list>
            </field>
        </record>

        <record id="view_finance_api_dealers_search" model="ir.ui.view">
            <field name="name">res.partner.finance.api.dealers.search</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="x_dealer_code"/>
                    <filter string="Companies" name="filter_companies" domain="[('is_company', '=', True)]"/>
                    <filter string="Code Assigned" name="filter_has_code" domain="[('x_dealer_code', '!=', False)]"/>
                    <filter string="Code Missing" name="filter_no_code" domain="[('x_dealer_code', '=', False)]"/>
                </search>
            </field>
        </record>

        <record id="action_finance_api_dealers" model="ir.actions.act_window">
            <field name="name">Dealers</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_finance_api_dealers_list"/>
            <field name="search_view_id" ref="view_finance_api_dealers_search"/>
            <field name="context">{'search_default_filter_companies': 1}</field>
            <field name="help">
                Assign the Dealer Code each dealer is known by to Bajaj Finance (or
                any finance partner) here, inline — no need to open each Contact
                individually. Only affects the Finance API's dealerCode lookup.
            </field>
        </record>

    </data>
</odoo>
