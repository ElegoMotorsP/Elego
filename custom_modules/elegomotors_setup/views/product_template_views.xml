<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            Adds the "Requires QC Inward" checkbox to the product form.
            When checked, units of this product must pass Pratik's QC Inward
            inspection before entering EGO/Store. Unchecked = direct-to-store.
        -->
        <record id="product_template_form_qc_required" model="ir.ui.view">
            <field name="name">product.template.form.qc.required</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='sale_ok']" position="after">
                    <field name="x_qc_required"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
