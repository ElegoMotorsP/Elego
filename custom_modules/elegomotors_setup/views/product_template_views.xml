<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            Adds the "Requires QC Inward" checkbox to the product form.
            When checked, units of this product must pass Pratik's QC Inward
            inspection before entering EGO/Store. Unchecked = direct-to-store.
        -->
        <record id="product_template_form_qc_required" model="ir.ui.view">
            <field name="name">product.template.form.qc.required</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='general_information']" position="inside">
                    <group string="Quality Control">
                        <field name="x_qc_required"/>
                    </group>
                    <group string="QC Inspection Parameters" invisible="not x_qc_required"
                           colspan="2">
                        <field name="x_qc_parameter_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name" string="Parameter"/>
                                <field name="expected_value" string="Expected Value"/>
                                <field name="result_type" string="Type"/>
                                <field name="check_description" string="How to Check"/>
                            </list>
                        </field>
                    </group>
                    <group string="Kit Purchase">
                        <field name="x_kit_price_default"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
