<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ElegoMotors — Picking Operations PDF: Sr. No. column

        stock.report_picking (Gate Entry / internal transfers / any picking's
        "Picking Operations" print) — separate template from the Delivery
        Slip (stock.report_deliveryslip), already fixed.

        The product <td> here has no name/id attribute (confirmed live), and
        this template has many other unrelated <td> elements throughout
        (address blocks etc.), so a bare //td[1] would be ambiguous. Anchored
        instead via the stable named header th_product's closest enclosing
        <table>, then the first <td> within just that table — robust without
        depending on the table's own class string.

        Verified against the only other view inheriting this template that
        touches the product row: l10n_in_stock's gst_report_picking_inherit
        adds the HSN/SAC line via position="after" on the description SPAN
        inside the first <td> (not the <td> itself), so it doesn't conflict
        with adding a new <td> before it.

        KNOWN TRADEOFF (accepted by user 2026-09-24): a Studio customization
        already exists on this report, styling a column by absolute position
        (td[5], assumed to be Lot/Serial Number, bold+centered). Adding this
        Sr. No. column shifts every column after it by one, so that Studio
        styling will land on the wrong column until manually re-pointed in
        Studio afterward.
    -->

    <template id="report_picking_document_ego" inherit_id="stock.report_picking">

        <xpath expr="//th[@name='th_product']" position="before">
            <th name="th_ego_sr" class="text-center">
                <div align="left"><strong>Sr. No.</strong></div>
            </th>
        </xpath>

        <xpath expr="//th[@name='th_product']/ancestor::table[1]//td[1]" position="before">
            <td class="text-center" t-esc="ml_index + 1"/>
        </xpath>

    </template>

</odoo>
