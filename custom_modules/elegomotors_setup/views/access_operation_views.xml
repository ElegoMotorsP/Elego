<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_access_operation_list" model="ir.ui.view">
            <field name="name">elegomotors.access.operation.list</field>
            <field name="model">elegomotors.access.operation</field>
            <field name="arch" type="xml">
                <list string="Access Control" editable="bottom" create="false" delete="false"
                      decoration-muted="not is_wired and not not_implemented"
                      decoration-danger="not_implemented">
                    <field name="sequence" optional="hide"/>
                    <field name="module"/>
                    <field name="menu" optional="show"/>
                    <field name="name" readonly="1"/>
                    <field name="access_type" widget="badge"
                           decoration-info="access_type in ('view', 'report')"
                           decoration-warning="access_type == 'operate'"
                           decoration-danger="access_type in ('approve', 'admin', 'delete')"/>
                    <field name="sensitivity" widget="badge"
                           decoration-success="sensitivity == 'low'"
                           decoration-info="sensitivity == 'medium'"
                           decoration-warning="sensitivity == 'high'"
                           decoration-danger="sensitivity == 'critical'"/>
                    <field name="status_label" string="Status"/>
                    <field name="granted_user_ids" widget="many2many_tags"
                           readonly="not is_wired or not_implemented"
                           placeholder="Not enforced — cannot grant yet"/>
                    <field name="business_purpose" optional="hide"/>
                    <field name="is_wired" column_invisible="1"/>
                    <field name="not_implemented" column_invisible="1"/>
                </list>
            </field>
        </record>

        <record id="view_access_operation_search" model="ir.ui.view">
            <field name="name">elegomotors.access.operation.search</field>
            <field name="model">elegomotors.access.operation</field>
            <field name="arch" type="xml">
                <search string="Access Control">
                    <field name="name" string="Operation"/>
                    <field name="module"/>
                    <field name="granted_user_ids"/>
                    <filter name="filter_wired" string="Live (Enforced)" domain="[('is_wired', '=', True)]"/>
                    <filter name="filter_unwired" string="Not Yet Enforced"
                            domain="[('is_wired', '=', False), ('not_implemented', '=', False)]"/>
                    <filter name="filter_not_implemented" string="Feature Not Built"
                            domain="[('not_implemented', '=', True)]"/>
                    <separator/>
                    <filter name="filter_critical" string="Critical Sensitivity" domain="[('sensitivity', '=', 'critical')]"/>
                    <group expand="1" string="Group By">
                        <filter name="group_by_module" string="Module" context="{'group_by': 'module'}"/>
                        <filter name="group_by_access_type" string="Access Type" context="{'group_by': 'access_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_access_operation" model="ir.actions.act_window">
            <field name="name">Access Control</field>
            <field name="res_model">elegomotors.access.operation</field>
            <field name="view_mode">list</field>
            <field name="context">{'search_default_group_by_module': 1}</field>
            <field name="search_view_id" ref="view_access_operation_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Every operation the business has approved for review, grouped by module.
                </p>
                <p>
                    "Granted To" is live group membership — adding or removing someone here
                    takes effect immediately. Rows marked "Not Yet Enforced" have no dedicated
                    permission behind them yet in this system; toggling them does nothing real.
                </p>
            </field>
        </record>

        <!-- Same access level Manohar just received (base.group_system) — exactly whoever
             holds that can reach this screen and manage everyone else's access from it. -->
        <menuitem id="menu_access_operation_root"
                  name="Access Control"
                  groups="base.group_system"
                  sequence="90"/>
        <menuitem id="menu_access_operation"
                  name="Operations"
                  parent="menu_access_operation_root"
                  action="action_access_operation"
                  sequence="10"/>

    </data>
</odoo>
