<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Outgoing Delivery Changes — reduce quantity, replace a bike serial,
        or change the bike (model/colour), before the delivery is
        validated. A reason is compulsory and every change is logged
        (elegomotors.delivery.change.log) with who/when from Odoo's own
        create_uid/create_date, plus a chatter post on the delivery.

        Access: elegomotors_setup.group_delivery_change_operator
        (Amit + Manohar initially) — enforced in Python
        (delivery_change_wizard.py) as well as hidden here.
    -->

    <record id="view_delivery_change_wizard_form" model="ir.ui.view">
        <field name="name">elegomotors.delivery.change.wizard.form</field>
        <field name="model">elegomotors.delivery.change.wizard</field>
        <field name="arch" type="xml">
            <form string="Modify Delivery">
                <sheet>
                    <div class="alert alert-warning mb-3" role="alert">
                        <strong>Changes here apply immediately once you click Apply</strong> —
                        pick an action for each unit you want to change, and enter a
                        reason (required). Reducing a unit's quantity will leave the
                        remainder to be shipped as a backorder when you validate.
                    </div>
                    <field name="picking_id" invisible="1"/>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="false" delete="false">
                            <field name="product_display" string="Bike Unit" readonly="1"/>
                            <field name="action"/>
                            <field name="new_product_id"
                                   string="New Model/Colour"
                                   invisible="action != 'change_bike'"/>
                            <field name="move_id" column_invisible="1"/>
                            <field name="move_line_id" column_invisible="1"/>
                            <field name="lot_id" column_invisible="1"/>
                        </list>
                    </field>
                    <group>
                        <field name="reason" required="1" placeholder="Why is this delivery being changed? (required)"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply"
                            string="Apply Changes"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- "Modify Delivery" button on outgoing deliveries — Amit + Manohar only -->
    <record id="stock_picking_form_delivery_change" model="ir.ui.view">
        <field name="name">stock.picking.form.delivery.change</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='button_validate']" position="before">
                <button name="action_open_delivery_change_wizard"
                        string="Modify Delivery"
                        type="object"
                        class="btn-secondary"
                        invisible="picking_type_code != 'outgoing' or state not in ('assigned', 'confirmed')"
                        groups="elegomotors_setup.group_delivery_change_operator"/>
            </xpath>
        </field>
    </record>

    <!-- Change history tab — visible to everyone who can see the delivery -->
    <record id="stock_picking_form_delivery_change_log" model="ir.ui.view">
        <field name="name">stock.picking.form.delivery.change.log</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Delivery Change Log" invisible="not x_delivery_change_ids">
                    <field name="x_delivery_change_ids" nolabel="1" readonly="1">
                        <list>
                            <field name="create_date" string="When"/>
                            <field name="create_uid" string="By"/>
                            <field name="change_type"/>
                            <field name="old_value"/>
                            <field name="new_value"/>
                            <field name="reason"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
