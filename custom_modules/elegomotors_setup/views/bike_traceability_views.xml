<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ElegoMotors — Bike Traceability Search Window

        Provides a dedicated list + search view on stock.lot, filtered to
        all ElegoMotors bike templates (EGO-S1, Elego 1.1, Elego 1.2, Elego 2.0+).
        The search bar's default field ("Any Serial No.") ORs across all seven
        serial fields simultaneously so staff can type any known serial —
        chassis, motor, battery, controller, charger, cluster, or frame —
        and immediately find the matching bike.

        Accessible via: Inventory > Bike Traceability — placed under the
        Inventory app root (stock.menu_stock_root, gated on
        stock.group_stock_manager/stock.group_stock_user) rather than
        Manufacturing, since Amit (Store), Rajshri (Accounts), and Priyanka
        (Sales) all hold a stock group but not mrp.group_mrp_user, and
        need this report — every ElegoMotors user with Inventory access
        can now reach it, matching "all authorized users."

        "Produced On" = the lot's create_date. Every bike serial is created
        at the exact moment Pratik/Prashant confirms the barcode capture
        wizard (mrp_production.py / bulk_barcode_wizard.py), i.e. the moment
        the physical unit finishes assembly — so create_date is a reliable
        production-date stamp without needing a new field or MO lookup.
        Default sort is by this date ascending, so the list reads as a
        production sequence (matches serial numbers, which also increment
        over time) — click the column header to reverse or re-sort.
    -->

    <!-- ── List view ──────────────────────────────────────────────────── -->
    <record id="view_bike_traceability_list" model="ir.ui.view">
        <field name="name">elegomotors.bike.traceability.list</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <list string="Bike Traceability" create="false"
                  default_order="create_date asc, name asc"
                  decoration-danger="x_blacklisted">
                <field name="name"                string="Serial No."          optional="show"/>
                <field name="create_date"         string="Produced On"         optional="show"/>
                <field name="product_id"          string="Variant"             optional="show"/>
                <field name="x_color"             string="Colour"              optional="show"/>
                <field name="x_chassis_serial"    string="Chassis No."         optional="show"/>
                <field name="x_motor_serial"      string="Motor No."           optional="show"/>
                <field name="x_controller_serial" string="Controller No."      optional="show"/>
                <field name="x_battery_serial"    string="Battery No."         optional="show"/>
                <field name="x_charger_serial"    string="Charger No."         optional="show"/>
                <field name="x_battery_type"      string="Battery Type"        optional="show"/>
                <field name="x_cluster_serial"    string="Cluster Serial"      optional="hide"/>
                <field name="x_frame_serial"      string="Frame Serial"        optional="hide"/>
                <field name="x_blacklisted"       string="Blacklisted"         optional="show"
                       widget="boolean"/>
            </list>
        </field>
    </record>

    <!-- ── Search view ────────────────────────────────────────────────── -->
    <record id="view_bike_traceability_search" model="ir.ui.view">
        <field name="name">elegomotors.bike.traceability.search</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <search string="Search Bikes">

                <!-- Universal search: one query across all serial fields -->
                <field name="name" string="Any Serial No."
                    filter_domain="['|', '|', '|', '|', '|', '|', '|',
                        ('name',                'ilike', self),
                        ('x_chassis_serial',    'ilike', self),
                        ('x_motor_serial',      'ilike', self),
                        ('x_battery_serial',    'ilike', self),
                        ('x_controller_serial', 'ilike', self),
                        ('x_charger_serial',    'ilike', self),
                        ('x_cluster_serial',    'ilike', self),
                        ('x_frame_serial',      'ilike', self)]"/>

                <!-- Per-field searches for precise lookups -->
                <field name="name"                string="Serial No."/>
                <field name="create_date"         string="Produced On"/>
                <field name="x_chassis_serial"    string="Chassis No."/>
                <field name="x_color"             string="Colour"/>
                <field name="x_motor_serial"      string="Motor Serial"/>
                <field name="x_battery_serial"    string="Battery Serial"/>
                <field name="x_controller_serial" string="Controller Serial"/>
                <field name="x_charger_serial"    string="Charger Serial"/>
                <field name="x_cluster_serial"    string="Cluster Serial"/>
                <field name="x_frame_serial"      string="Frame Serial"/>

                <separator/>

                <filter name="filter_blacklisted"
                        string="Blacklisted"
                        domain="[('x_blacklisted', '=', True)]"/>
                <filter name="filter_active"
                        string="Active (Not Blacklisted)"
                        domain="[('x_blacklisted', '=', False)]"/>

                <group expand="0" string="Group By">
                    <filter name="group_by_product"
                            string="Product Variant"
                            context="{'group_by': 'product_id'}"/>
                    <filter name="group_by_blacklisted"
                            string="Blacklisted Status"
                            context="{'group_by': 'x_blacklisted'}"/>
                    <filter name="group_by_production_date"
                            string="Production Date"
                            context="{'group_by': 'create_date'}"/>
                </group>

            </search>
        </field>
    </record>

    <!-- ── Window action ──────────────────────────────────────────────── -->
    <record id="action_bike_traceability" model="ir.actions.act_window">
        <field name="name">Bike Traceability</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,form</field>
        <field name="domain" eval="[('product_id.product_tmpl_id', 'in', [
            ref('elegomotors_setup.tmpl_ego_scooter'),
            ref('elegomotors_setup.tmpl_elego_11'),
            ref('elegomotors_setup.tmpl_elego_12'),
            ref('elegomotors_setup.tmpl_elego_20p'),
        ])]"/>
        <field name="context">{'create': False}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_bike_traceability_list')})]"/>
        <field name="search_view_id" ref="view_bike_traceability_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No bikes found.
            </p>
            <p>
                Search by chassis number, motor serial, battery serial,
                or any other component serial number.
            </p>
        </field>
    </record>

    <!-- ── Menu: Inventory > Bike Traceability ─────────────────────────
         Parented on the Inventory app root so it's reachable by every
         user with stock.group_stock_manager/stock.group_stock_user —
         not just Manufacturing users — matching "all authorized users". -->
    <menuitem
        id="menu_bike_traceability"
        name="Bike Traceability"
        parent="stock.menu_stock_root"
        action="action_bike_traceability"
        sequence="60"/>

</odoo>
