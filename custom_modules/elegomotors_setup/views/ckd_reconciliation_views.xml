<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_ckd_reconciliation_form" model="ir.ui.view">
            <field name="name">elegomotors.ckd.reconciliation.form</field>
            <field name="model">elegomotors.ckd.reconciliation</field>
            <field name="arch" type="xml">
                <form string="CKD Reconciliation" create="0" edit="0" delete="0">
                    <header>
                        <button name="action_download_xlsx" type="object"
                                string="Download Excel" class="btn-primary"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="order_id"/></h1>
                        </div>
                        <div class="alert alert-info" role="alert">
                            <field name="status" nolabel="1"/>
                        </div>
                        <group>
                            <group string="Kit value">
                                <field name="allocated_value"/>
                                <field name="expected_value"/>
                                <field name="value_difference"/>
                            </group>
                            <group string="Duty / landed cost">
                                <field name="landed_value"/>
                                <field name="boe_capitalised"/>
                                <field name="landed_difference"/>
                                <field name="inventory_value" string="Final Inventory Value"/>
                            </group>
                        </group>
                        <field name="currency_id" invisible="1"/>
                        <field name="line_ids" nolabel="1">
                            <list decoration-warning="note != 'OK'" create="0" delete="0" edit="0">
                                <field name="product_id"/>
                                <field name="kit_names" optional="show"/>
                                <field name="qty_per_kit" optional="show"/>
                                <field name="cost_share"/>
                                <field name="frozen" optional="show"/>
                                <field name="ordered_qty"/>
                                <field name="received_qty"/>
                                <field name="allocated_value" sum="Kit Value"/>
                                <field name="expected_value" sum="Expected" optional="show"/>
                                <field name="landed_value" sum="Duty / Landed"/>
                                <field name="final_value" sum="Final"/>
                                <field name="note"/>
                                <field name="currency_id" column_invisible="1"/>
                            </list>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>
