<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ElegoMotors — Bills of Materials for Elego 1.1 (template-level placeholder)

        This template-level BOM for Elego 1.1 is created here for reference but is
        immediately removed at runtime by _ensure_elego_11_color_boms() which creates
        authoritative variant-specific BOMs (one per color) instead.

        Elego 1.2 and 2.0+ placeholder BOMs have been removed — their color-specific
        variant BOMs are created directly by _ensure_elego_12_color_boms() and
        _ensure_elego_20p_color_boms() via bom_data_elego_12_by_color.xml and
        bom_data_elego_20p_by_color.xml.

        noupdate="1": the runtime methods handle all modifications.
    -->
    <data noupdate="1">

        <!-- ── Elego 1.1 BoM (removed at runtime by _ensure_elego_11_color_boms) ── -->
        <record id="bom_elego_11" model="mrp.bom">
            <field name="product_tmpl_id" ref="elegomotors_setup.tmpl_elego_11"/>
            <field name="product_qty">1.0</field>
            <field name="product_uom_id" ref="uom.product_uom_unit"/>
            <field name="type">normal</field>
            <field name="produce_delay">7</field>
        </record>

        <record id="bom_line_11_frame"    model="mrp.bom.line"><field name="bom_id" ref="bom_elego_11"/><field name="product_id" ref="elegomotors_setup.comp_steel_frame"/>       <field name="product_qty">1.0</field><field name="product_uom_id" ref="uom.product_uom_unit"/><field name="sequence">10</field></record>
        <record id="bom_line_11_motor"    model="mrp.bom.line"><field name="bom_id" ref="bom_elego_11"/><field name="product_id" ref="elegomotors_setup.comp_hub_motor"/>         <field name="product_qty">1.0</field><field name="product_uom_id" ref="uom.product_uom_unit"/><field name="sequence">20</field></record>
        <record id="bom_line_11_battery"  model="mrp.bom.line"><field name="bom_id" ref="bom_elego_11"/><field name="product_id" ref="elegomotors_setup.comp_battery_pack"/>      <field name="product_qty">1.0</field><field name="product_uom_id" ref="uom.product_uom_unit"/><field name="sequence">30</field></record>
        <record id="bom_line_11_ctrl"     model="mrp.bom.line"><field name="bom_id" ref="bom_elego_11"/><field name="product_id" ref="elegomotors_setup.comp_controller"/>        <field name="product_qty">1.0</field><field name="product_uom_id" ref="uom.product_uom_unit"/><field name="sequence">40</field></record>
        <record id="bom_line_11_wiring"   model="mrp.bom.line"><field name="bom_id" ref="bom_elego_11"/><field name="product_id" ref="elegomotors_setup.comp_wiring_harness"/>    <field name="product_qty">1.0</field><field name="product_uom_id" ref="uom.product_uom_unit"/><field name="sequence">50</field></record>
        <record id="bom_line_11_fwheel"   model="mrp.bom.line"><field name="bom_id" ref="bom_elego_11"/><field name="product_id" ref="elegomotors_setup.comp_front_wheel"/>       <field name="product_qty">1.0</field><field name="product_uom_id" ref="uom.product_uom_unit"/><field name="sequence">60</field></record>
        <record id="bom_line_11_rwheel"   model="mrp.bom.line"><field name="bom_id" ref="bom_elego_11"/><field name="product_id" ref="elegomotors_setup.comp_rear_wheel"/>        <field name="product_qty">1.0</field><field name="product_uom_id" ref="uom.product_uom_unit"/><field name="sequence">70</field></record>
        <record id="bom_line_11_fork"     model="mrp.bom.line"><field name="bom_id" ref="bom_elego_11"/><field name="product_id" ref="elegomotors_setup.comp_front_fork"/>        <field name="product_qty">1.0</field><field name="product_uom_id" ref="uom.product_uom_unit"/><field name="sequence">80</field></record>
        <record id="bom_line_11_brakes"   model="mrp.bom.line"><field name="bom_id" ref="bom_elego_11"/><field name="product_id" ref="elegomotors_setup.comp_brake_kit"/>         <field name="product_qty">1.0</field><field name="product_uom_id" ref="uom.product_uom_unit"/><field name="sequence">90</field></record>
        <record id="bom_line_11_head"     model="mrp.bom.line"><field name="bom_id" ref="bom_elego_11"/><field name="product_id" ref="elegomotors_setup.comp_headlight"/>         <field name="product_qty">1.0</field><field name="product_uom_id" ref="uom.product_uom_unit"/><field name="sequence">100</field></record>
        <record id="bom_line_11_tail"     model="mrp.bom.line"><field name="bom_id" ref="bom_elego_11"/><field name="product_id" ref="elegomotors_setup.comp_taillight"/>         <field name="product_qty">1.0</field><field name="product_uom_id" ref="uom.product_uom_unit"/><field name="sequence">110</field></record>
        <record id="bom_line_11_cluster"  model="mrp.bom.line"><field name="bom_id" ref="bom_elego_11"/><field name="product_id" ref="elegomotors_setup.comp_instrument_cluster"/><field name="product_qty">1.0</field><field name="product_uom_id" ref="uom.product_uom_unit"/><field name="sequence">120</field></record>
        <record id="bom_line_11_seat"     model="mrp.bom.line"><field name="bom_id" ref="bom_elego_11"/><field name="product_id" ref="elegomotors_setup.comp_seat"/>              <field name="product_qty">1.0</field><field name="product_uom_id" ref="uom.product_uom_unit"/><field name="sequence">130</field></record>
        <record id="bom_line_11_panels"   model="mrp.bom.line"><field name="bom_id" ref="bom_elego_11"/><field name="product_id" ref="elegomotors_setup.comp_body_panels"/>       <field name="product_qty">1.0</field><field name="product_uom_id" ref="uom.product_uom_unit"/><field name="sequence">140</field></record>
        <record id="bom_line_11_fastener" model="mrp.bom.line"><field name="bom_id" ref="bom_elego_11"/><field name="product_id" ref="elegomotors_setup.comp_fasteners"/>         <field name="product_qty">1.0</field><field name="product_uom_id" ref="uom.product_uom_unit"/><field name="sequence">150</field></record>
        <record id="bom_line_11_pack"     model="mrp.bom.line"><field name="bom_id" ref="bom_elego_11"/><field name="product_id" ref="elegomotors_setup.comp_packaging"/>         <field name="product_qty">1.0</field><field name="product_uom_id" ref="uom.product_uom_unit"/><field name="sequence">160</field></record>

    </data>
</odoo>
