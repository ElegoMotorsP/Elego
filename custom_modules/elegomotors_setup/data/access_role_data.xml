<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ElegoMotors Access Role Templates — starting-point permission
        bundles for the "Access Role" picker (Settings → Access Matrix, or
        the Access Role field on a user form). Each one below mirrors the
        group bundle the corresponding department user already holds today
        (see data/users_data.xml / USERS_AND_PERMISSIONS_REFERENCE.md).

        noupdate="1": seeded once. From here on these are admin-owned —
        Manohar can edit a role's Grants (Settings → Access Matrix →
        Access Roles) or create new roles entirely from the UI, and a
        module upgrade will never overwrite his changes.
    -->
    <data noupdate="1">

        <record id="access_role_admin" model="elegomotors.access.role">
            <field name="name">Admin</field>
            <field name="sequence">10</field>
            <field name="group_ids" eval="[(6, 0, [
                ref('base.group_erp_manager'),
                ref('base.group_system'),
                ref('purchase.group_purchase_manager'),
                ref('sales_team.group_sale_manager'),
                ref('stock.group_stock_manager'),
                ref('mrp.group_mrp_user'),
                ref('mrp.group_mrp_routings'),
                ref('mrp.group_mrp_manager'),
                ref('account.group_account_user'),
                ref('hr.group_hr_user'),
                ref('elegomotors_setup.group_inbound_operator'),
                ref('elegomotors_setup.group_qc_pass_operator'),
                ref('elegomotors_setup.group_fg_transfer_operator'),
                ref('quality.group_quality_user'),
                ref('base.group_allow_export'),
                ref('elegomotors_setup.group_unbuild_rebuild_operator'),
                ref('elegomotors_setup.group_delivery_change_operator'),
            ])]"/>
        </record>

        <record id="access_role_store_manager" model="elegomotors.access.role">
            <field name="name">Store Manager</field>
            <field name="sequence">20</field>
            <field name="group_ids" eval="[(6, 0, [
                ref('stock.group_stock_manager'),
                ref('elegomotors_setup.group_purchase_viewer'),
                ref('elegomotors_setup.group_sale_viewer'),
                ref('account.group_account_invoice'),
                ref('elegomotors_setup.group_store_billing'),
                ref('elegomotors_setup.group_inbound_operator'),
                ref('base.group_allow_export'),
                ref('elegomotors_setup.group_delivery_change_operator'),
            ])]"/>
        </record>

        <record id="access_role_purchase" model="elegomotors.access.role">
            <field name="name">Purchase</field>
            <field name="sequence">30</field>
            <field name="group_ids" eval="[(6, 0, [
                ref('purchase.group_purchase_user'),
                ref('elegomotors_setup.group_manufacturing_operator'),
                ref('stock.group_stock_user'),
                ref('elegomotors_setup.group_fg_transfer_operator'),
                ref('elegomotors_setup.group_purchase_vendor_bill_viewer'),
                ref('base.group_allow_export'),
            ])]"/>
        </record>

        <record id="access_role_accounts" model="elegomotors.access.role">
            <field name="name">Accounts</field>
            <field name="sequence">40</field>
            <field name="group_ids" eval="[(6, 0, [
                ref('account.group_account_user'),
                ref('elegomotors_setup.group_purchase_viewer'),
                ref('sales_team.group_sale_manager'),
                ref('stock.group_stock_user'),
                ref('elegomotors_setup.group_sale_approver'),
                ref('base.group_allow_export'),
            ])]"/>
        </record>

        <record id="access_role_hr" model="elegomotors.access.role">
            <field name="name">HR</field>
            <field name="sequence">50</field>
            <field name="group_ids" eval="[(6, 0, [
                ref('hr.group_hr_manager'),
                ref('hr_attendance.group_hr_attendance_manager'),
                ref('hr_holidays.group_hr_holidays_responsible'),
            ])]"/>
        </record>

        <record id="access_role_quality" model="elegomotors.access.role">
            <field name="name">Quality / Manufacturing</field>
            <field name="sequence">60</field>
            <field name="group_ids" eval="[(6, 0, [
                ref('elegomotors_setup.group_manufacturing_operator'),
                ref('stock.group_stock_manager'),
                ref('quality.group_quality_manager'),
                ref('quality.group_quality_user'),
                ref('elegomotors_setup.group_qc_pass_operator'),
                ref('elegomotors_setup.group_fg_transfer_operator'),
                ref('elegomotors_setup.group_warranty_manager'),
                ref('base.group_allow_export'),
            ])]"/>
        </record>

        <record id="access_role_sales_crm" model="elegomotors.access.role">
            <field name="name">Sales / CRM</field>
            <field name="sequence">70</field>
            <field name="group_ids" eval="[(6, 0, [
                ref('sales_team.group_sale_salesman'),
                ref('stock.group_stock_user'),
                ref('base.group_allow_export'),
            ])]"/>
        </record>

    </data>
</odoo>
