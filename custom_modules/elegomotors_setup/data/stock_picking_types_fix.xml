<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ElegoMotors Stock Operation Types — FIXES

        This file fixes the operation types to properly handle:
        1. Vendor returns (when inward QC fails or material needs replacement)
        2. Customer returns (when delivered products come back)
        3. Warehouse configuration to use Gate Entry as primary receipt

        Applied with noupdate="0" so changes are always enforced on upgrade.
    -->
    <data noupdate="0">

        <!-- Add Vendor Returns operation type (for returning goods to suppliers) -->
        <record id="picking_type_vendor_returns" model="stock.picking.type">
            <field name="name">Returns to Vendors</field>
            <field name="code">outgoing</field>
            <field name="sequence_code">RTV</field>
            <field name="warehouse_id" ref="stock.warehouse0"/>
            <field name="default_location_src_id" ref="elegomotors_setup.location_ego_quarantine"/>
            <field name="default_location_dest_id" ref="stock.stock_location_suppliers"/>
            <field name="color">1</field>
            <field name="sequence">22</field>
        </record>

        <!-- Update Gate Entry to have return type pointing to Vendor Returns -->
        <record id="elegomotors_setup.picking_type_gate_entry" model="stock.picking.type">
            <field name="return_picking_type_id" ref="picking_type_vendor_returns"/>
        </record>

        <!-- Update Delivery to have return type pointing to Gate Entry (customer returns come in as receipts) -->
        <record id="elegomotors_setup.picking_type_delivery" model="stock.picking.type">
            <field name="return_picking_type_id" ref="elegomotors_setup.picking_type_gate_entry"/>
        </record>

        <!--
            NOTE: We intentionally do NOT override stock.warehouse0.in_type_id or out_type_id.
            Overriding those fields causes Odoo's own sale_purchase_stock tests to fail:
            - test_cross_dock_flow expects picking_type_id=1 (WH/Receipts) and
              location_dest_id=8 (WH/Stock), but our Gate Entry (1551 → QC Inward 9)
              would replace them.
            - test_mto_cancel_multi_steps_confirmed_purchase also breaks when the
              warehouse outgoing type is our custom Delivery instead of WH/Delivery.

            ElegoMotors workflow: Gate Entry (Inward) and Delivery (PDI + Dispatch) are
            standalone operation types that Amit uses directly from the Inventory Overview.
            They do not need to be set as the warehouse's primary in/out types.
        -->

        <!-- ================================================================
             13-Mar access control: set group_id on operation types to
             restrict which users see the card in the Inventory Overview and
             can create/validate transfers of that type.

             Gate Entry + Issue to Production → group_inbound_operator
                 Members: Amit, Manohar
                 Excluded: Pratik (loses both in 13-Mar update)

             QC Pass → Store → group_qc_pass_operator
                 Members: Pratik, Manohar
                 Excluded: Amit (loses QC Pass in 13-Mar update)

             FG to Finished Goods Store → group_fg_transfer_operator
                 Members: Pratik, Prashant, Manohar
                 Excluded: Amit (loses FG transfer; Prashant gains it)
        ================================================================ -->
        <record id="elegomotors_setup.picking_type_gate_entry" model="stock.picking.type">
            <field name="group_id" ref="elegomotors_setup.group_inbound_operator"/>
        </record>

        <record id="elegomotors_setup.picking_type_production_issue" model="stock.picking.type">
            <field name="group_id" ref="elegomotors_setup.group_inbound_operator"/>
        </record>

        <record id="elegomotors_setup.picking_type_qc_to_store" model="stock.picking.type">
            <field name="group_id" ref="elegomotors_setup.group_qc_pass_operator"/>
        </record>

        <record id="elegomotors_setup.picking_type_fg_to_stock" model="stock.picking.type">
            <field name="group_id" ref="elegomotors_setup.group_fg_transfer_operator"/>
        </record>

    </data>
</odoo>
