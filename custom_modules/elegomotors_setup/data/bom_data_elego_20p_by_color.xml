<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ElegoMotors — Elego 2.0+ Color-Specific Bills of Materials

        Creates one variant-specific BOM per color (Red, White, Gray, Black):
          - 10 color-specific body panels (incl. chrome side parts shared across colors)
          - 107 common components
          = 117 parts total per variant (source: 2.0+ BOM XLSX files per color)

        Also removes the generic template-level BOM (bom_elego_20p) so Odoo's
        MO auto-select always picks the correct color-specific BOM.

        noupdate="0" — runs on every module upgrade so component list changes
        in code are always reflected in the database.

        Must load AFTER bom_data_new_models.xml (tmpl_elego_20p must exist) and
        AFTER product_models_data.xml (_ensure_new_model_attributes creates variants).
    -->
    <data noupdate="0">
        <function model="product.template" name="_ensure_elego_20p_color_boms"/>
    </data>
</odoo>
