<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Sequence: Warranty Claim Numbers — WC-YYMM-NNNN, resets monthly. -->
        <record id="seq_warranty_claim" model="ir.sequence">
            <field name="name">Warranty Claim Number</field>
            <field name="code">elegomotors.warranty.claim</field>
            <field name="prefix">WC-%(y)s%(month)s-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

    </data>
</odoo>
