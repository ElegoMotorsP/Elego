<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ElegoMotors Department Users — Production Data

        Seven department users with least-privilege group assignments.
        noupdate="1" — passwords and group memberships are NOT overwritten
        on module upgrade once the users have been created in the database.

        SECURITY NOTE: Passwords provided here are temporary first-login
        credentials. Each user should change their password immediately
        after first login via Settings → My Profile.

        Department  | User            | Login                            | Temp Password
        ============|=================|==================================|===============
        Admin       | Manohar Kalbhor | manohar.kalbhor@elegomotors.com  | manohar@123
        Store Mgr   | Amit Kale       | storeelegomotors@gmail.com       | amitkale@123
        Purchase    | Prashant Khedkar| NPD@elegomotors.com              | prashant@123
        Accounts    | Rajshri Kadam   | elegoac@gmail.com                | rajshri@123
        HR          | Srushti Gund    | hrelegomotors@gmail.com          | srusti@123
        Quality/WTY | Pratik Gund     | quality.elego23@gmail.com        | pratik@123
        Sales/CRM   | Tushar Gaikwad  | leads@elegomotors.com            | tushar@123
    -->
    <data noupdate="1">

        <!-- ============================================================
             1. ADMIN / APPROVALS — Manohar Kalbhor
             Responsibilities: PO approval (2-step), item/vendor approval,
                               dealer creation, MIS reports across all depts.
             Groups:
               • ERP Manager       — access to Settings + all installed apps
               • Purchase Manager  — PO 2-step approval authority
               • Sales Manager     — sales pipeline + SO oversight
               • Stock Manager     — warehouse creation, inventory config
               • MRP User          — production + BOM oversight
               • Accounting User   — financial reports, journals, P&L
             ============================================================ -->
        <record id="user_ego_manohar" model="res.users">
            <field name="name">Manohar Kalbhor</field>
            <field name="login">manohar.kalbhor@elegomotors.com</field>
            <field name="email">manohar.kalbhor@elegomotors.com</field>
            <field name="phone">7264829045</field>
            <field name="password">manohar@123</field>
            <field name="notification_type">inbox</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="groups_id" eval="[
                (4, ref('base.group_user')),
                (4, ref('base.group_erp_manager')),
                (4, ref('purchase.group_purchase_manager')),
                (4, ref('sales_team.group_sale_manager')),
                (4, ref('stock.group_stock_manager')),
                (4, ref('mrp.group_mrp_user')),
                (4, ref('mrp.group_mrp_routings')),
                (4, ref('account.group_account_user')),
            ]"/>
        </record>

        <!-- ============================================================
             2. STORE MANAGER — Amit Kale
             Responsibilities: Inward/outward stock movement, warehouse
                               configuration, Gate Entry, QC Inward,
                               Picking Slips, Production Issue, Inventory
                               management, received qty validation.
                               Creates Sales Invoices post-PDI (prices
                               are read-only — set from the Sales Order).
             Views: PO, Sales Orders, all stock reports, Customer Invoices
                    only (Vendor Bills are NOT accessible to Amit).
             Groups:
               • Stock Manager     — full warehouse + transfer management,
                                     location/route config, inventory adjust
               • Purchase User     — view and receive against POs
               • Sale Salesman     — view SOs to cross-ref delivery demand
               • Billing User      — model-level access to account.move
                                     (required for Create Invoice on SO/Delivery)
               • Store Billing     — record rule restricts account.move to
                                     out_invoice/out_refund only; view override
                                     makes price_unit + discount read-only
             NOTE: mrp.group_mrp_user REMOVED — Amit cannot produce MOs.
             The "Produce All" button is restricted to group_manufacturing_operator
             (Pratik). Amit issues material via "Issue to Production" transfer;
             Pratik validates receipt and produces.
             ============================================================ -->
        <record id="user_ego_amit" model="res.users">
            <field name="name">Amit Kale</field>
            <field name="login">storeelegomotors@gmail.com</field>
            <field name="email">storeelegomotors@gmail.com</field>
            <field name="phone">7758825757</field>
            <field name="password">amitkale@123</field>
            <field name="notification_type">inbox</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="groups_id" eval="[
                (4, ref('base.group_user')),
                (4, ref('stock.group_stock_manager')),
                (4, ref('purchase.group_purchase_user')),
                (4, ref('sales_team.group_sale_salesman')),
                (4, ref('account.group_account_invoice')),
                (4, ref('elegomotors_setup.group_store_billing')),
            ]"/>
        </record>

        <!-- ============================================================
             3. PURCHASE — Prashant Khedkar
             Responsibilities: PO creation, item/vendor/HSN creation,
                               terms & conditions, purchase pricing,
                               rejection/return to vendor, BOM creation.
             Views: Inventory reports, production reports.
             Groups:
               • Purchase User     — PO creation and management
               • MRP User          — BOM creation + production view
                                     (BOM access requires MRP module)
               • Stock User        — inventory reports, current stock view
             ============================================================ -->
        <record id="user_ego_prashant" model="res.users">
            <field name="name">Prashant Khedkar</field>
            <field name="login">NPD@elegomotors.com</field>
            <field name="email">NPD@elegomotors.com</field>
            <field name="phone">7387364457</field>
            <field name="password">prashant@123</field>
            <field name="notification_type">inbox</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="groups_id" eval="[
                (4, ref('base.group_user')),
                (4, ref('purchase.group_purchase_user')),
                (4, ref('mrp.group_mrp_user')),
                (4, ref('stock.group_stock_user')),
            ]"/>
        </record>

        <!-- ============================================================
             4. ACCOUNTS — Rajshri Kadam
             Responsibilities: Payments (send/receive — EXCLUSIVE), SO
                               approval (2-step alongside Manohar),
                               customer/dealer creation, sales returns,
                               JV entries, purchase bill booking, all
                               account reports.
             Views: PO, Production, Sales Orders, all stock + acct reports.
             Groups:
               • Accounting User   — full double-entry accounting, journals,
                                     reconciliation, JV, payments, reports
               • Purchase User     — view POs for 3-way matching
               • Sales Manager     — SO 2-step approval authority; implies
                                     Sale Salesman (view SOs for invoice
                                     matching); replaces explicit salesman
               • MRP User          — production cost visibility
               • Stock User        — stock valuation reports
             ============================================================ -->
        <record id="user_ego_rajshri" model="res.users">
            <field name="name">Rajshri Kadam</field>
            <field name="login">elegoac@gmail.com</field>
            <field name="email">elegoac@gmail.com</field>
            <field name="phone">8766793409</field>
            <field name="password">rajshri@123</field>
            <field name="notification_type">inbox</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="groups_id" eval="[
                (4, ref('base.group_user')),
                (4, ref('account.group_account_user')),
                (4, ref('purchase.group_purchase_user')),
                (4, ref('sales_team.group_sale_manager')),
                (4, ref('mrp.group_mrp_user')),
                (4, ref('stock.group_stock_user')),
            ]"/>
        </record>

        <!-- ============================================================
             5. HR — Srushti Gund
             Responsibilities: Employee records, attendance, payroll,
                               leave management, HR reporting.
             Views: HR module only (no ERP cross-module access required).
             Groups:
               • HR Manager             — full employee management, contracts,
                                          org chart, all employee data
               • Attendance Manager     — view + manage attendance for all
                                          employees, generate attendance reports
               • Time Off Responsible   — approve/refuse leave requests,
                                          manage leave allocations
             NOTE: hr_payroll is Odoo Enterprise only. When the EE license
             is activated, add hr_payroll.group_hr_payroll_user here.
             ============================================================ -->
        <record id="user_ego_srushti" model="res.users">
            <field name="name">Srushti Gund</field>
            <field name="login">hrelegomotors@gmail.com</field>
            <field name="email">hrelegomotors@gmail.com</field>
            <field name="phone">9529261357</field>
            <field name="password">srusti@123</field>
            <field name="notification_type">inbox</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="groups_id" eval="[
                (4, ref('base.group_user')),
                (4, ref('hr.group_hr_manager')),
                (4, ref('hr_attendance.group_hr_attendance_manager')),
                (4, ref('hr_holidays.group_hr_holidays_responsible')),
            ]"/>
        </record>

        <!-- ============================================================
             6. QUALITY & MANUFACTURING — Pratik Gund
             Responsibilities:
               Inward QC:       inspect material at QC Inward location,
                                pass → validate QC Pass → Store transfer,
                                fail → validate QC Fail → Quarantine transfer.
               Manufacturing:   validate "Issue to Production" transfer
                                (acknowledges material receipt at floor),
                                click Produce All on MO (EXCLUSIVE — via
                                group_manufacturing_operator),
                                validate FG → Finished Goods transfer.
               Post-Prod QC:    quality check form on FG transfer —
                                pass → FG moves to Finished Goods,
                                fail → stay in Production WIP / raise alert.
               Warranty:        inward/outward stock moves for warranty claims.
             Groups:
               • Manufacturing Operator — EXCLUSIVE Produce All access on MOs;
                                          implies mrp.group_mrp_user
               • MRP Routings          — keep for form access (no work orders
                                          in BOM, but still useful for config)
               • Stock Manager         — validate QC transfers, scrap orders,
                                          inward/outward warranty moves
               • Quality Manager       — quality.point / quality.check /
                                          quality.alert management (Community
                                          quality module, not Enterprise)
             ============================================================ -->
        <record id="user_ego_pratik" model="res.users">
            <field name="name">Pratik Gund</field>
            <field name="login">quality.elego23@gmail.com</field>
            <field name="email">quality.elego23@gmail.com</field>
            <field name="phone">9223003686</field>
            <field name="password">pratik@123</field>
            <field name="notification_type">inbox</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="groups_id" eval="[
                (4, ref('base.group_user')),
                (4, ref('elegomotors_setup.group_manufacturing_operator')),
                (4, ref('mrp.group_mrp_routings')),
                (4, ref('stock.group_stock_manager')),
                (4, ref('quality.group_quality_manager')),
            ]"/>
        </record>

        <!-- ============================================================
             7. SALES & MARKETING / CRM — Tushar Gaikwad
             Responsibilities: Sales Order creation, Quotation creation
                               and confirmation, CRM pipeline management,
                               FG stock availability check before committing.
             Views: FG items stock report (read-only).
             Groups:
               • Sale Salesman     — Quotation + SO creation/confirmation,
                                     own CRM leads/opportunities, own SO only
               • Stock User        — read access to FG inventory for
                                     availability check before quoting
             ============================================================ -->
        <record id="user_ego_tushar" model="res.users">
            <field name="name">Tushar Gaikwad</field>
            <field name="login">leads@elegomotors.com</field>
            <field name="email">leads@elegomotors.com</field>
            <field name="phone">8265091207</field>
            <field name="password">tushar@123</field>
            <field name="notification_type">inbox</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="groups_id" eval="[
                (4, ref('base.group_user')),
                (4, ref('sales_team.group_sale_salesman')),
                (4, ref('stock.group_stock_user')),
            ]"/>
        </record>

    </data>
</odoo>
