<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ElegoMotors Company & System Configuration

        Settings applied to the main company:
        - 2-level PO approval (manager must approve all POs)
        - Lock POs after confirmation
        - 2-step SO approval (Rajshri or Manohar must approve all SOs)
        - Manufacturing resupply enabled on warehouse
        - Company name updated to ElegoMotors
        - Default currency: INR (Indian Rupee)
    -->
    <data noupdate="1">

        <!-- Update company name and details. -->
        <record id="base.main_company" model="res.company">
            <field name="name">ElegoMotors</field>
            <field name="po_double_validation">two_step</field>
            <field name="po_double_validation_amount">0.0</field>
            <field name="po_lock">lock</field>
            <!-- SO approval (sale_order_approval): enable in Settings when Enterprise sale_order_approval is installed. -->
        </record>

        <!-- Enable manufacture-to-resupply on default warehouse -->
        <record id="stock.warehouse0" model="stock.warehouse">
            <field name="name">ElegoMotors Warehouse</field>
            <field name="code">EGO</field>
            <field name="manufacture_to_resupply" eval="True"/>
        </record>

        <!-- Sequence: Sales Quotation — ElegoMotors prefix -->
        <record id="seq_elegomotors_sale" model="ir.sequence">
            <field name="name">ElegoMotors Sales Order</field>
            <field name="code">sale.order</field>
            <field name="prefix">EGO-SO-</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Sequence: Purchase Order — ElegoMotors prefix -->
        <record id="seq_elegomotors_po" model="ir.sequence">
            <field name="name">ElegoMotors Purchase Order</field>
            <field name="code">purchase.order</field>
            <field name="prefix">EGO-PO-</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Sequence: Manufacturing Order — ElegoMotors prefix -->
        <record id="seq_elegomotors_mo" model="ir.sequence">
            <field name="name">ElegoMotors Manufacturing Order</field>
            <field name="code">mrp.production</field>
            <field name="prefix">EGO-MO-</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Sequence: EGO-S1 Serial Numbers — EGO-S1-YYMM-NNNN, resets monthly. -->
        <record id="seq_ego_s1_serial" model="ir.sequence">
            <field name="name">ElegoMotors EV Scooter Serial Number</field>
            <field name="code">ego.s1.serial</field>
            <field name="prefix">EGO-S1-%(y)s%(month)s-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Sequence: Elego 1.1 Serial Numbers — EL11-YYMM-NNNN, resets monthly. -->
        <record id="seq_elego_11_serial" model="ir.sequence">
            <field name="name">Elego 1.1 Serial Number</field>
            <field name="code">elego.11.serial</field>
            <field name="prefix">EL11-%(y)s%(month)s-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Sequence: Elego 1.2 Serial Numbers — EL12-YYMM-NNNN, resets monthly. -->
        <record id="seq_elego_12_serial" model="ir.sequence">
            <field name="name">Elego 1.2 Serial Number</field>
            <field name="code">elego.12.serial</field>
            <field name="prefix">EL12-%(y)s%(month)s-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Sequence: Elego 2.0+ Serial Numbers — EL20-YYMM-NNNN, resets monthly. -->
        <record id="seq_elego_20p_serial" model="ir.sequence">
            <field name="name">Elego 2.0+ Serial Number</field>
            <field name="code">elego.20p.serial</field>
            <field name="prefix">EL20-%(y)s%(month)s-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

    </data>

    <!-- noupdate="0" — applied every upgrade so settings are always enforced -->
    <data noupdate="0">

        <!-- Activate INR currency so it can be set as the company default.
             INR is not active by default in Odoo; this enables it. -->
        <record id="base.INR" model="res.currency">
            <field name="active" eval="True"/>
        </record>

        <!-- Attempt to set INR as company currency. Silently no-ops when
             journal entries already exist (caught in Python try/except). -->
        <function model="res.company" name="_try_set_inr_currency"/>

        <!-- 2-step manufacturing: when Prashant confirms an MO, Odoo auto-creates a
             Picking Slip (Raw Material) linked to the MO via production.picking_ids.
             The picking uses our existing "Issue to Production" operation type (PI),
             moving components from EGO/Store → EGO/Production WIP.
             manufacture_steps='pbm' = "Pick Before Manufacture".
             noupdate="0" ensures this is re-applied on every module upgrade. -->
        <record id="stock.warehouse0" model="stock.warehouse">
            <field name="manufacture_steps">pbm</field>
            <field name="pbm_type_id" ref="elegomotors_setup.picking_type_production_issue"/>
        </record>

        <!-- REMOVE Work Orders / MRP Routings from all internal users.
             Manufacturing at ElegoMotors is a SINGLE ASSEMBLY POINT.
             Disabling mrp_routings removes the Work Orders tab from MOs,
             giving a simple Draft → Confirm → Produce All → Done flow.
             bom_data_fix.xml deletes the existing routing operations.
             NOTE: previously this block ADDED mrp_routings; now it REMOVES it. -->
        <record model="res.groups" id="base.group_user">
            <field name="implied_ids" eval="[(3, ref('mrp.group_mrp_routings'))]"/>
        </record>

    </data>
</odoo>
