<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate: seeded once; Purchase / Accounts can rename or re-parent from the UI. -->
    <data noupdate="1">

        <!-- Home of every CKD kit product (kits never hold stock). -->
        <record id="product_category_ckd_kits" model="product.category">
            <field name="name">CKD Kits</field>
            <field name="parent_id" ref="product.product_category_all"/>
        </record>

        <!-- Reference for the Bill of Entry: BOE/2026/0001 -->
        <record id="seq_bill_of_entry" model="ir.sequence">
            <field name="name">Bill of Entry</field>
            <field name="code">elegomotors.bill.of.entry</field>
            <field name="prefix">BOE/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
