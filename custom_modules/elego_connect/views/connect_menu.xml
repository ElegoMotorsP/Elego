<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Elego Connect root menu — admin-only (base.group_erp_manager), same
        as the existing Warranty/Finance API Clients menus. This is
        integration plumbing (credentials, request log), not something
        regular staff need to see — they use the Elego Connect app itself,
        not this Odoo menu.
    -->
    <menuitem id="menu_connect_root"
              name="Elego Connect"
              sequence="28"
              groups="base.group_erp_manager"/>

    <menuitem id="menu_connect_api_clients"
              name="API Clients"
              parent="menu_connect_root"
              action="action_connect_api_client"
              sequence="10"/>

    <menuitem id="menu_connect_api_log"
              name="API Request Log"
              parent="menu_connect_root"
              action="action_connect_api_log"
              sequence="20"/>
</odoo>
