<odoo>
  <data>
<record id="view_vehicle_tracking_xls_wizard" model="ir.ui.view">
  <field name="name">vehicle.tracking.xls.report.wizard</field>
  <field name="model">vtr.xls.report</field>
  <field name="arch" type="xml">
    <form string="Vehicle Tracking XLSX Report">
      <sheet>
        <!-- Row 1: From Date and To Date -->
        <group>
          <group>
            <field name="sales_invoice_date_start"/>
          </group>
          <group>
            <field name="sales_invoice_date_end"/>
          </group>
        </group>

        <!-- Row 2 & 3: 2x2 layout -->
        <group>
          <group>
            <field name="customer_ids" widget="many2many_tags"/>
            <field name="invoice_ids" widget="many2many_tags"/>
          </group>
          <group>
            <field name="product_ids" widget="many2many_tags"/>
            <field name="location_ids" widget="many2many_tags"/>
          </group>
        </group>

        <footer>
          <button name="export_xls" type="object" string="Export" class="btn-primary"/>
          <button string="Cancel" class="btn-default" special="cancel"/>
        </footer>
      </sheet>
    </form>
  </field>
</record>

    <!-- Action and menu -->
    <record id="action_vehicle_tracking_wizard" model="ir.actions.act_window">
      <field name="name">Vehicle Tracking Register</field>
      <field name="res_model">vtr.xls.report</field>
      <field name="view_mode">form</field>
      <field name="target">new</field>
      <field name="view_id" ref="view_vehicle_tracking_xls_wizard"/>
    </record>

    <menuitem id="menu_elego_reports" name="Elego Reports" parent="account.menu_finance_reports" sequence="99"/>
    <menuitem id="menu_vehicle_tracking_v3" name="Vehicle Tracking Register" parent="menu_elego_reports" action="action_vehicle_tracking_wizard" sequence="1"/>
  </data>
</odoo>
