<odoo>
    <template id="report_invoice_document_format">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: Arial, sans-serif; font-size: 10pt; padding: 0 10px;">
                        <t t-call="custom_invoice_report.report_invoice_document_content"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>