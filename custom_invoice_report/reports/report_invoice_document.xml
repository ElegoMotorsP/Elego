<odoo>
    <template id="report_invoice_document_format">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id or res_company"/> 
                <t t-call="custom_invoice_report.report_invoice_document_content" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>
    
    
    <template id="report_invoice_document_content">
        
        <t t-if="not company" t-set="company" t-value="o.company_id or res_company"/>
        <t t-set="partner" t-value="o.partner_id"/>
        <t t-set="invoice_data" t-value="o"/>

        <t t-set="all_component_serials" t-value="o._get_component_serials_by_line()"/>
        
        <div class="article"> 
            
            <div class="row" style="border: 2px solid black; margin: 0; padding: 5px;">
                <div class="col-12 text-center">
                    <strong style="font-size: 14pt;">ELEGO MOTORS</strong>
                    <br/>
                    <small>Elego Motors Pvt Ltd</small>
                    <br/>
                    <small>Gat No-69, Amoni Mala, Nangaon, Tal- Daund, Dist- Pune 412203, Maharashtra</small>
                    <br/>
                    <small>Phone: <t t-esc="company.phone or '7350085757'"/></small> 
                    <br/>
                    <small>Email: <t t-esc="company.email or 'elegoac@gmail.com'"/> WebSite: <t t-esc="company.website or 'www.elegomotors.com'"/></small>
                    <br/>
                    <small>GST No: <t t-esc="company.vat or '27AAFCE3013K1ZT'"/> | PAN: <t t-esc="company.partner_id.vat and company.partner_id.vat[:10] or 'AAFCE3013K'"/></small>
                </div>
            </div>

            <div class="row" style="border-left: 2px solid black; border-right: 2px solid black; border-top: 1px solid black; margin: 0; padding: 5px;">
                <div class="col-12 text-center">
                    <strong style="font-size: 12pt;">TAX INVOICE</strong>
                    <span class="float-right"><small>Duplicate Copy</small></span>
                </div>
            </div>
            
            <div class="row" style="border: 2px solid black; margin: 0;">
                
                <div class="col-4" style="border-right: 1px solid black; padding: 5px; min-height: 150px;">
                    <strong class="text-decoration-underline">Invoice Details:</strong>
                    <table class="table table-sm table-borderless" style="font-size: 9pt; margin-bottom: 0;">
                        <tr><td style="width: 50%; padding: 0; line-height: 1.2;"><strong>Invoice No.</strong></td><td style="padding: 0; line-height: 1.2;">: <t t-esc="invoice_data.name or ''"/></td></tr>
                        <tr><td style="width: 50%; padding: 0; line-height: 1.2;"><strong>Invoice Date</strong></td><td style="padding: 0; line-height: 1.2;">: <t t-esc="invoice_data.invoice_date.strftime('%d-%b-%Y') if invoice_data.invoice_date else ''"/></td></tr>
                        <tr><td style="width: 50%; padding: 0; line-height: 1.2;"><strong>Cust PO No. &amp; Date</strong></td><td style="padding: 0; line-height: 1.2;">: <t t-esc="o.invoice_origin or ''"/> &amp; <t t-esc="invoice_data.invoice_date.strftime('%d-%b-%Y') if invoice_data.invoice_date else ''"/></td></tr>
                        <tr><td style="width: 50%; padding: 0; line-height: 1.2;"><strong>SO No.</strong></td><td style="padding: 0; line-height: 1.2;">: <t t-esc="o.invoice_origin or ''"/></td></tr>
                        <tr><td style="width: 50%; padding: 0; line-height: 1.2;"><strong>SO Date</strong></td><td style="padding: 0; line-height: 1.2;">: <t t-esc="invoice_data.invoice_date.strftime('%d-%b-%Y') if invoice_data.invoice_date else ''"/></td></tr>
                        <tr><td style="width: 50%; padding: 0; line-height: 1.2;"><strong>State</strong></td><td style="padding: 0; line-height: 1.2;">: <t t-esc="partner.state_id.name or ''"/></td></tr>
                        <tr><td style="width: 50%; padding: 0; line-height: 1.2;"><strong>State Code</strong></td><td style="padding: 0; line-height: 1.2;">: <t t-esc="partner.state_id.code or ''"/></td></tr>
                    </table>
                </div>

                <div class="col-4" style="border-right: 1px solid black; padding: 5px; min-height: 150px;">
                    <strong class="text-decoration-underline">Details of Receiver | Billed to:</strong>
                    <address style="margin-bottom: 0; font-size: 9pt; line-height: 1.2;">
                        <strong>Name:</strong> <t t-esc="partner.name or ''"/><br/>
                        <strong>Address:</strong> <t t-esc="partner.street or ''"/>, <t t-esc="partner.street2 or ''"/>, <t t-esc="partner.city or ''"/> - <t t-esc="partner.zip or ''"/><br/>
                        <strong>GST No:</strong> <t t-esc="partner.vat or ''"/><br/>
                        <strong>PAN No.:</strong> <t t-esc="partner.vat and partner.vat[:10] or ''"/><br/>
                        <strong>State:</strong> <t t-esc="partner.state_id.name or ''"/><br/>
                        <strong>State Code:</strong> <t t-esc="partner.state_id.code or ''"/><br/>
                    </address>
                </div>
                
                <div class="col-4" style="padding: 5px; min-height: 150px;">
                    <strong class="text-decoration-underline">Details of Consignee | Shipped to:</strong>
                    <t t-set="shipping_partner" t-value="o.partner_shipping_id or partner"/>
                    <address style="margin-bottom: 0; font-size: 9pt; line-height: 1.2;">
                        <strong>Name:</strong> <t t-esc="shipping_partner.name or ''"/><br/>
                        <strong>Address:</strong> <t t-esc="shipping_partner.street or ''"/>, <t t-esc="shipping_partner.street2 or ''"/>, <t t-esc="shipping_partner.city or ''"/> - <t t-esc="shipping_partner.zip or ''"/><br/>
                        <strong>GST No:</strong> <t t-esc="shipping_partner.vat or ''"/><br/>
                        <strong>PAN No.:</strong> <t t-esc="shipping_partner.vat and shipping_partner.vat[:10] or ''"/><br/>
                        <strong>State:</strong> <t t-esc="shipping_partner.state_id.name or ''"/><br/>
                        <strong>State Code:</strong> <t t-esc="shipping_partner.state_id.code or ''"/><br/>
                        <strong>Contact Person:</strong> <t t-esc="shipping_partner.display_name or ''"/>
                    </address>
                </div>
            </div>

            <div class="row" style="border-left: 2px solid black; border-right: 2px solid black; border-bottom: 2px solid black; margin: 0; padding: 5px;">
                <div class="col-12" style="font-size: 9pt; line-height: 1.2;">
                    <div class="row m-0 p-0">
                        <div class="col-6"><strong>Transportation Mode:</strong> By Road</div>
                        <div class="col-6"><strong>Transportation Name:</strong> [N/A]</div>
                    </div>
                    <div class="row m-0 p-0">
                        <div class="col-6"><strong>LR No. &amp; Date:</strong> [N/A] / <t t-esc="invoice_data.invoice_date.strftime('%d-%b-%Y') if invoice_data.invoice_date else ''"/></div>
                        <div class="col-6"><strong>Date of Supply:</strong> <t t-esc="invoice_data.invoice_date.strftime('%d-%b-%Y') if invoice_data.invoice_date else ''"/></div>
                    </div>
                    <div class="row m-0 p-0">
                        <div class="col-6"><strong>Vehicle Number:</strong> <t t-esc="o.narration or ''"/></div>
                        <div class="col-6"><strong>E-Way No. &amp; Date:</strong> [N/A]</div>
                    </div>
                    <div class="row m-0 p-0">
                        <div class="col-6"><strong>Place of Supply:</strong> <t t-esc="partner.state_id.name or ''"/></div>
                    </div>
                </div>
            </div>
            
            <table class="table table-bordered" style="width: 100%; border: 2px solid black; margin-top: 10px; font-size: 9pt;">
                <thead style="background-color: #f8f9fa;">
                    <tr style="border: 1px solid black;">
                        <th class="text-center" style="width: 5%; border: 1px solid black;">Sr.No.</th>
                        <th class="text-center" style="width: 25%; border: 1px solid black;">Description Of Goods</th>
                        <th class="text-center" style="width: 25%; border: 1px solid black;">Vehicle Details / Serial No.</th>
                        <th class="text-center" style="width: 7%; border: 1px solid black;">GST(%)</th>
                        <th class="text-center" style="width: 8%; border: 1px solid black;">HSN Code</th>
                        <th class="text-center" style="width: 5%; border: 1px solid black;">Quantity</th>
                        <th class="text-center" style="width: 10%; border: 1px solid black;">Rate</th>
                        <th class="text-center" style="width: 5%; border: 1px solid black;">Disc(%)</th>
                        <th class="text-center" style="width: 10%; border: 1px solid black;">Total Amount(Rs.)</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="current_line_index" t-value="1"/>
                    <t t-foreach="o.invoice_line_ids" t-as="line">
                        <t t-if="line.display_type == 'product'">
                            <tr style="border: 1px solid black;">
                                <td class="text-center" style="border: 1px solid black; line-height: 1.2; padding: 3px;"><t t-esc="current_line_index"/></td>
                                <td style="border: 1px solid black; line-height: 1.2; padding: 3px;">
                                    <t t-esc="line.name"/>
                                </td>
                                
                                <td style="border: 1px solid black; line-height: 1.2; padding: 3px;">
                                    <t t-set="formatted_serials" t-value="all_component_serials.get(line.id, [])"/>
                                    
                                    <t t-if="formatted_serials">
                                        <t t-foreach="formatted_serials" t-as="serial_string">
                                            
                                            <t t-esc="serial_string"/>
                                            
                                            <t t-if="not serial_string_last">
                                                <br/>
                                            </t>
                                            
                                        </t>
                                    </t>
                                    <t t-else="">
                                        [N/A]
                                    </t>
                                </td>
                                <td class="text-center" style="border: 1px solid black; line-height: 1.2; padding: 3px;"><t t-esc="'%.2f' % (line.tax_ids[0].amount if line.tax_ids else 0.0)"/></td>
                                <td class="text-center" style="border: 1px solid black; line-height: 1.2; padding: 3px;"><t t-esc="line.product_id.hs_code or ''"/></td>
                                <td class="text-center" style="border: 1px solid black; line-height: 1.2; padding: 3px;"><t t-esc="'%.2f' % line.quantity"/></td>
                                <td class="text-right" style="border: 1px solid black; line-height: 1.2; padding: 3px;"><t t-esc="'%.2f' % line.price_unit"/></td>
                                <td class="text-center" style="border: 1px solid black; line-height: 1.2; padding: 3px;"><t t-esc="'%.2f' % line.discount"/></td>
                                <td class="text-right" style="border: 1px solid black; line-height: 1.2; padding: 3px;"><t t-esc="'%.2f' % line.price_subtotal"/></td>
                            </tr>
                            <t t-set="current_line_index" t-value="current_line_index + 1"/>
                        </t>
                    </t>
                </tbody>
            </table>

            <div class="row" style="border: 2px solid black; margin: 0; min-height: 150px;">
                
                <div class="col-8" style="border-right: 1px solid black; padding: 5px; font-size: 9pt;">
                    <strong>Gross Value (In Words):</strong>
                    <br/>
                    <strong style="text-transform: capitalize;">
                          <!-- <span t-field="invoice_data.amount_total_text" t-options='{"replace_label": [("Dollars", "Rupees"), ("Cents", "")]}'/> Only -->
                        <t t-if="invoice_data.amount_total_text">
    <span t-field="invoice_data.amount_total_text"/>
</t>
<t t-else="">
    <span t-field="invoice_data.amount_total"/>
</t>
                    </strong>
                    
                    <br/><br/>
                    <strong class="text-decoration-underline">Terms &amp; Conditions:</strong>
                    <ol style="margin-top: 0; margin-bottom: 0; line-height: 1.2;">
                        <li style="margin-left: -20px;">Certified that the particulars given are true &amp; correct and the amount indicated represents the price actually charged and that there is no flow of addition/consideration directly or indirectly from the buyer.</li>
                        <li style="margin-left: -20px;">Subject to DAUND Jurisdiction Only</li>
                    </ol>
                </div>

                <div class="col-4" style="padding: 5px;">
                    <table class="table table-sm table-borderless" style="font-size: 9pt; margin-bottom: 0;">
                        
                        <tr>
                            <td style="width: 50%; padding: 0; line-height: 1.2;"><strong>Net Value:</strong></td>
                            <td class="text-right" style="padding: 0; line-height: 1.2;">
                                <span t-field="invoice_data.amount_untaxed" t-options='{"widget": "monetary", "display_currency": invoice_data.currency_id}'/>
                            </td>
                        </tr>

                        <t t-foreach="invoice_data.line_ids.filtered(lambda line: line.tax_line_id)" t-as="line">
                            <tr>
                                <td style="width: 50%; padding: 0; line-height: 1.2;"><strong><t t-esc="line.tax_line_id.name"/>:</strong></td>
                                <td class="text-right" style="padding: 0; line-height: 1.2;">
                                    <t t-set="tax_amount" t-value="abs(line.balance)"/>
                                    <span t-esc="tax_amount" t-options='{"widget": "monetary", "display_currency": invoice_data.currency_id}'/>
                                </td>
                            </tr>
                        </t>

                        <t t-set="round_off_value" 
                        t-value="invoice_data.amount_total - (invoice_data.amount_untaxed + invoice_data.amount_tax)"/>

                        <t t-if="invoice_data.currency_id.round(round_off_value) != 0.0">
                            <tr>
                                <td style="width: 50%; padding: 0; line-height: 1.2;"><strong>Round Off:</strong></td>
                                <td class="text-right" style="padding: 0; line-height: 1.2;">
                                    <span t-esc="round_off_value" t-options='{"widget": "monetary", "display_currency": invoice_data.currency_id}'/>
                                </td>
                            </tr>
                        </t>
                        
                        <tr style="border-top: 1px solid black;">
                            <td style="width: 50%; padding: 0; line-height: 1.2;"><strong>Grand Total:</strong></td>
                            <td class="text-right" style="padding: 0; line-height: 1.2;">
                                <strong><span t-field="invoice_data.amount_total" t-options='{"widget": "monetary", "display_currency": invoice_data.currency_id}'/></strong>
                            </td>
                        </tr>
                    </table>
                    
                    <div class="text-center mt-4">
                        <strong style="margin-top: 50px;">For, <t t-esc="company.name or 'Elego Motors Pvt Ltd'"/></strong>
                        <div style="height: 50px;"></div>
                        <strong class="text-decoration-underline">Authorised Signatory</strong>
                    </div>
                </div>
            </div>
            
            <div class="row" style="margin: 0; padding-top: 5px; font-size: 8pt; border-left: 2px solid black; border-right: 2px solid black; border-bottom: 2px solid black;">
                 <div class="col-12 text-center">
                    Reg.Office Address:- Gat No-69, Amoni Mala, Nangaon, Tal- Daund, Dist- Pune 412203, Maharashtra
                </div>
            </div>
        </div>
    </template>
</odoo>