<odoo>
  <record id="form_sale_order_view" model = "ir.ui.view">
  <field name="name">sale.order.form.view</field>
   <field name="model">sale.order</field>
   <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
        <xpath expr="//page[@name='order_lines']" position="inside">
            <field name ="number_to_words"/> 
        </xpath>
    </field>
    </record>

     <record id="form_invoice_view" model = "ir.ui.view">
  <field name="name">invoice.form.view</field>
   <field name="model">account.move</field>
   <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
        <field name="narration" position="after">
            <field name ="number_to_words"/> 
        </field>
    </field>
    </record>

<record id="form_purchase_order_view" model = "ir.ui.view">
  <field name="name">purchase.order.form.view</field>
   <field name="model">purchase.order</field>
   <field name="inherit_id" ref="purchase.purchase_order_form"/>
    <field name="arch" type="xml">
        <xpath expr="//group[hasclass('oe_subtotal_footer')]" position="after">
            <field name ="number_to_words"/> 
        </xpath>
    </field>
    </record>

</odoo>
