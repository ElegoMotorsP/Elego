<odoo>
  <record id="view_product_template_inherit_serial_mandatory" model="ir.ui.view">
    <field name="name">product.template.inherit.serial.mandatory</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_only_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//group[@name='inventory']" position="inside">
        <field name="x_serial_mandatory"/>
      </xpath>
    </field>
  </record>
</odoo>
