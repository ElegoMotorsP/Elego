<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model='ir.ui.view' id='vtr_xls_report_view_form'>
        <field name="name">vtr.xls.report.view.form</field>
        <field name="model">vtr.xls.report</field>
        <field name="arch" type="xml">
            <form string="Vehicle Tracking Report">
                <group>
                    <group>
                        <field name="sales_invoice_date_start"/>
                        <field name="sales_invoice_date_end"/>
                    </group>
                    <group>
                        <field name="company_ids" widget="many2many_tags"/>
                        <field name="invoice_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="export_xls" type="object" default_focus="1"
                            string="Export Vehicle Tracking Register Report"
                            class="oe_highlight"
                            context="{'xls_export':1}" icon="fa-download"/>
                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <record model='ir.actions.act_window' id='vtr_xls_report_action'>
        <field name="name">Export Vehicle Tracking Report in Excel</field>
        <field name="res_model">vtr.xls.report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="vtr_xls_report_view_form"/>
        <field name="target">new</field>
    </record>
    
    <menuitem name="Vehicle Tracking Register in Excel"
              parent="stock.menu_warehouse_report"
              id="export_excel"
              action="vtr_xls_report_action"
              sequence="3"/>
</odoo>