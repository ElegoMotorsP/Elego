<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="view_vehicle_component_role_list" model="ir.ui.view">
      <field name="name">vehicle.component.role.list</field>
      <field name="model">vehicle.component.role</field>
      <field name="arch" type="xml">
        <list>
          <field name="product_tmpl_id"/>
          <field name="role"/>
          <field name="active"/>
        </list>
      </field>
    </record>

    <record id="view_vehicle_component_role_form" model="ir.ui.view">
      <field name="name">vehicle.component.role.form</field>
      <field name="model">vehicle.component.role</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="product_tmpl_id"/>
              <field name="role"/>
              <field name="active"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record id="action_vehicle_component_roles" model="ir.actions.act_window">
      <field name="name">Component Roles</field>
      <field name="res_model">vehicle.component.role</field>
      <field name="view_mode">list,form</field>
    </record>
  </data>
</odoo>
