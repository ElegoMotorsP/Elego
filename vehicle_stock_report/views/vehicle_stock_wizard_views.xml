<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="view_vehicle_stock_export_wizard" model="ir.ui.view">
      <field name="name">vehicle.stock.export.wizard.form</field>
      <field name="model">vehicle.stock.export.wizard</field>
      <field name="arch" type="xml">
        <form string="Export Vehicle Stock">
          <group>
            <field name="model_name" placeholder="Model contains..."/>
            <field name="chassis_no" placeholder="Chassis contains..."/>
            <field name="customer_name" placeholder="Customer contains..."/>
            <field name="sales_from"/>
            <field name="sales_to"/>
          </group>
          <footer>
            <button string="Export XLSX" type="object" name="action_export_xlsx" class="btn btn-primary"/>
            <button string="Export CSV" type="object" name="action_export_csv" class="btn btn-secondary"/>
            <button string="Cancel" special="cancel" class="btn-secondary"/>
          </footer>
        </form>
      </field>
    </record>

    <record id="action_vehicle_stock_export_wizard" model="ir.actions.act_window">
      <field name="name">Export Vehicle Stock</field>
      <field name="res_model">vehicle.stock.export.wizard</field>
      <field name="view_mode">form</field>
      <field name="target">new</field>
    </record>
  </data>
</odoo>
